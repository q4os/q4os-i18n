msgid "<font size=\"4\"><p align=justify><b>Welcome to Q4OS</b>, fast and powerful desktop operating system focused on long-term stability, reliability and classic style user interface.</p><p align=justify>Q4OS is installed as a very basic and clean desktop environment with the minimal software kit. Now it's the right time to adjust your new desktop, you might want to make use of tweaking shortcuts below.</p></font>"
msgstr "<font size=\"4\"><p align=justify><b>Vítejte v Q4OS</b>, rychlém a výkonném operačním systému zaměřeném na dlouhodobou stabilitu, spolehlivost a uživatelské rozhraní v klasickém stylu.</p><p align=justify>Q4OS je nainstalován jako velmi základní a čisté prostředí s minimální softwarovou výbavou. Nyní je ten správný čas přizpůsobit si Váš nový desktop, můžete využít tlačítka akcí níže.</p></font>"

msgid "<font size=\"4\"><p>Bypass login screen and login without entering your password after the system boot.</p></font>"
msgstr "<font size=\"4\"><p>Přeskočte přihlašovací obrazovku a přihlašujte se po zavedení systému bez zadávání hesla.</p></font>"

msgid "<font size=\"4\"><p>Desktop Profiler will automatically install and configure set of additional Applications and tools, all in single click.</p><p>You will be allowed to select between different desktop profiles.</p></font>"
msgstr "<font size=\"4\"><p>Desktop Profiler nainstaluje a zkonfiguruje sadu dalších Aplikací a nástrojů, vše jedním kliknutím.</p><p>Budete si moci vybrat mezi různými desktopovými profily.</p></font>"

msgid "<font size=\"4\"><p>Other useful configuration options.</p></font>"
msgstr "<font size=\"4\"><p>Další užitečné možnosti nastavení.</p></font>"

msgid "<font size=\"4\"><p>Run an interactive script to install extra collection of professional quality codecs.</p><p>Media players such as VLC or Mplayer make use of these codecs in order to provide support for playback of DVD and multimedia files encoded through these codecs.</p></font>"
msgstr "<font size=\"4\"><p>Spustí interaktivní skript pro instalaci vybrané kolekce kodeků v profesionální kvalitě.</p><p>Přehrávače médií, jako třeba VLC nebo Mplayer využijí tyto kodeky pro podporu přehrávání DVD a multimediálních souborů kódovaných pomocí těchto kodeků.</p></font>"

msgid "<font size=\"4\"><p>Switch to alternative Kickoff Start menu.</p><p>Well arranged, modern style start menu offers search bar, favorites tab, history and more.</p></font>"
msgstr "<font size=\"4\"><p>Přepněte na alternativní Kickoff Start menu.</p><p>Dobře uspořádané, moderní start menu nabízí vyhledávací pruh, záložku oblíbených položek, historii a více.</p></font>"

msgid "<font size=\"4\"><p>You will be directed to Q4OS web resources to download and install standalone useful applications.</p></font>"
msgstr "<font size=\"4\"><p>Budete přesměrováni na webové zdroje Q4OS, abyste mohli stáhnout a nainstalovat jednotlivé aplikace.</p></font>"

msgid "<p>Automatic login is now disabled.</p>"
msgstr "<p>Automatické přihlašování je nyní vypnuto.</p>"

msgid "<p>Automatic login is now enabled.</p>"
msgstr "<p>Automatické přihlašování je nyní zapnuto.</p>"

msgid "<p>Desktop effects have been disabled.</p>"
msgstr "<p>Efekty desktopu byly zakázány.</p>"

msgid "<p>Desktop effects have been enabled. Please login again to take changes effect.</p>"
msgstr "<p>Efekty desktopu byly povoleny. Prosím přihlašte se znovu, aby se změny projevily.</p>"

msgid "<p>Do you want to enable Automatic login ?</p>"
msgstr "<p>Chcete povolit automatické přihlášení ?</p>"

msgid "<p>Do you want to switch the Start Menu ?</p>"
msgstr "<p>Chcete přepnout Start Menu ?</p>"

msgid "<p>Start Menu is now set to Bourbon style.</p>"
msgstr "<p>Nabídka Start je nyní nastavena na styl Bourbon.</p>"

msgid "<p>Start Menu is now set to Classic style.</p>"
msgstr "<p>Nabídka Start je nyní nastavena na klasický styl.</p>"

msgid "<p>Start Menu is now set to Kickoff style.</p>"
msgstr "<p>Nabídka Start je nyní nastavena na styl Kickoff.</p>"

msgid "<p>This action is available for Trinity and Plasma desktops only.</p>"
msgstr "<p>Tato akce je dostupná pouze pro desktopy Trinity a Plasma.</p>"

msgid "<p>This action is available for Trinity desktop only.</p>"
msgstr "<p>Tato akce je dostupná pouze pro desktop Trinity.</p>"

