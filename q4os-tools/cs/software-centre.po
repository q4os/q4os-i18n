msgid "<p>%1 is already installed, do you want to uninstall ?</p>"
msgstr "<p>%1 je již nainstalováno, chcete jej odinstalovat?</p>"

msgid "<p>NVIDIA installation has been detected !</p><p>Actions are disabled during NVIDIA setup, please wait until end of the NVIDIA installation.</p>"
msgstr "<p>Byla zjištěna instalace ovladače NVIDIA!</p><p>Během instalace NVIDIA jsou akce zakázány, počkejte prosím na dokončení instalace NVIDIA.</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, most likely, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p>"
msgstr "<p>Balíčkovací systém je zaneprázdněn, instalace nyní není možná. Nastavení nemůže pokračovat.</p><p>Zámek je nejspíše způsoben probíhajícími aktualizacemi systému na pozadí. V takovém případě je třeba chvíli počkat, než balíčkovací systém tyto operace dokončí. Ujistěte se prosím, že neinstalujete jinou aplikaci, a za několik minut instalaci opakujte.</p>"

msgid "<p>Select an application to install from the list of featured applications.</p>"
msgstr "<p>Vyberte aplikaci k instalaci ze seznamu doporučených aplikací.</p>"

msgid "<p>Virtualbox installation has been detected !</p><p>Actions are disabled during Virtualbox setup, please wait until end of the Virtualbox installation.</p>"
msgstr "<p>Byla zjištěna instalace Virtualboxu!</p><p>Během instalace Virtualboxu jsou akce zakázány, počkejte prosím na dokončení instalace Virtualboxu.</p>"

msgid "<p>You have applied no desktop profile yet. It's highly recommended to apply a desktop profile before installing applications.</p><p>Please run <b>Desktop Profiler</b> tool to choose and apply a profile.</p>"
msgstr "<p>Zatím jste nepoužili žádný profil pracovní plochy. Před instalací aplikací je důrazně doporučeno profil pracovní plochy použít.</p><p>Spusťte prosím nástroj <b>Desktop Profiler</b> a zvolte a použijte profil.</p>"

