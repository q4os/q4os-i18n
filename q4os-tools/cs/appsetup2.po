msgid "< Back"
msgstr "< Zpět"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Rychlé kontroly systému</b><br>&nbsp;&nbsp;&nbsp;Systém kontroluje prostředí pro instalaci"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Získání oprávnění</b><br>&nbsp;&nbsp;&nbsp;Systém žádá o oprávnění k instalaci"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Instalace</b><br>&nbsp;&nbsp;&nbsp;Počkejte prosím, software se instaluje"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Licenční ujednání</b><br>&nbsp;&nbsp;&nbsp;Před instalací si prosím přečtěte licenční podmínky"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Dokončení průvodce instalací _SUBST_SWNAME_</h2><br></p>\n<p>Software _SUBST_SWNAME_ byl nainstalován do vašeho počítače.<br></p>\n<p>Průvodce zavřete kliknutím na Dokončit.<br><br><br><br><br></p>\n<p>Novinky, časté dotazy a podporu najdete na webu _SUBST_SWNAME_</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr "<p><h2>Vítejte v průvodci instalací _SUBST_SWNAME_</h2></p>\n<p>Tento průvodce vás provede instalací aplikace _SUBST_SWNAME_.</p>\n<p>Pokračujte kliknutím na Další.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Zjištěná verze operačního systému: Q4OS <b>%1</b>.</p><p>Tato instalace %2 vyžaduje nejvýše Q4OS <b>%3</b>.</p><p> Instalace se ruší ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Zjištěná verze operačního systému: Q4OS <b>%1</b>.</p><p>Tato instalace %2 vyžaduje alespoň Q4OS <b>%3</b>.</p><p> Instalace se ruší ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Nepodařilo se zjistit verzi systému Q4OS.</p><p>Instalace se ruší ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Vstupní data jsou neúplná !</p><p> Instalace se ruší ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>Připojení k internetu není aktivní nebo je velmi pomalé. Instalátor potřebuje stáhnout balíčky aplikace z internetových zdrojů Q4OS. Instalace nemůže pokračovat ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Nemáte oprávnění k přístupu do systému, nejste ve skupině \"sudo\" !</p><p> Instalace se ruší ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>Balíčkový systém je zaneprázdněn, nyní nelze instalovat. Instalace nemůže pokračovat.</p><p>Zámek je velmi pravděpodobně způsoben aktualizací systému probíhající na pozadí. V takovém případě je třeba chvíli počkat, než balíčkový systém tyto operace dokončí. Ujistěte se prosím, že neinstalujete jinou aplikaci, a instalaci za několik minut zopakujte.</p><p>Probíhá úklid a rušení ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Balíčkový systém je v nekonzistentním stavu a je třeba jej opravit ručně. Instalace nyní nemůže pokračovat.</p><p>Probíhá úklid a rušení ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Balíčky se nepodařilo stáhnout, zkontrolujte prosím připojení k internetu. Je mi líto, nyní nelze instalovat.</p><p>Probíhá úklid a rušení ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Simulace nebyla úspěšná, je mi líto, nyní nelze instalovat.</p><p>Probíhá úklid a rušení ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Varování: zrušení instalace v této fázi může způsobit selhání balíčkového systému.</p><p>Opravdu chcete instalaci nyní přerušit ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Instalaci nelze spouštět pod uživatelem root !</p><p> Instalace se ruší ...</p>"

