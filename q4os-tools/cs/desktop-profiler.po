msgstr "Zadejte prosím kód sdíleného profilu nebo internetovou adresu:"

msgid "Please re-login active session as soon as possible."
msgstr "Co nejdříve se prosím znovu přihlaste do aktivní relace."

msgid "Please reboot as soon as possible."
msgstr "Co nejdříve prosím restartujte počítač."

msgid "Please reboot your computer as soon as possible. Do you want reboot just now ?"
msgstr "Co nejdříve prosím restartujte počítač. Chcete restartovat hned teď?"

msgid "Please restart X server as soon as possible."
msgstr "Co nejdříve prosím restartujte X server."

msgid "Please select default desktop environment."
msgstr "Vyberte prosím výchozí desktopové prostředí."

msgid "Please select default desktop environment. The lightweight and efficient Trinity desktop is installed and pre-configured as default at the moment. Nevertheless, Q4OS installer has autodetected your computer is powerful enough to operate more advanced KDE Plasma desktop environment."
msgstr "Vyberte prosím výchozí desktopové prostředí. V tuto chvíli je nainstalován a jako výchozí přednastaven lehký a efektivní desktop Trinity. Instalátor Q4OS však zjistil, že váš počítač je dostatečně výkonný pro pokročilejší desktopové prostředí KDE Plasma."

msgid "Previous profile:"
msgstr "Předchozí profil:"

msgid "Profile applied, installation successful."
msgstr "Profil použit, instalace proběhla úspěšně."

msgid "Profile description"
msgstr "Popis profilu"

msgid "Profile export"
msgstr "Export profilu"

msgid "Profile has been imported."
msgstr "Profil byl importován."

msgid "Profile has been removed."
msgstr "Profil byl odstraněn."

msgid "Profile info"
msgstr "Informace o profilu"

msgid "Profile name:"
msgstr "Název profilu:"

msgid "QSI applications to install:"
msgstr "Aplikace QSI k instalaci:"

msgid "Remote profile not found."
msgstr "Vzdálený profil nenalezen."

msgid "Remove profile"
msgstr "Odstranit profil"

msgid "Remove superfluous packages"
msgstr "Odstranit nadbytečné balíčky"

msgid "Root permissions needed, exiting ..."
msgstr "Jsou potřeba oprávnění roota, končím ..."

msgid "Select a profile from the list please."
msgstr "Vyberte prosím profil ze seznamu."

msgid "Selected profile has been saved to file:"
msgstr "Vybraný profil byl uložen do souboru:"

msgid "Software profile:"
msgstr "Softwarový profil:"

msgid "Starting profile installation ... "
msgstr "Spouštím instalaci profilu ... "

msgid "System profiles cannot be removed."
msgstr "Systémové profily nelze odstranit."

msgid "The lightweight and efficient <b>Trinity</b> desktop is installed and pre-configured as default at the moment. Nevertheless, Q4OS installer has autodetected your computer is powerful enough to operate more advanced <b>KDE Plasma</b> desktop environment."
msgstr "V tuto chvíli je nainstalován a jako výchozí přednastaven lehký a efektivní desktop <b>Trinity</b>. Instalátor Q4OS však zjistil, že váš počítač je dostatečně výkonný pro pokročilejší desktopové prostředí <b>KDE Plasma</b>."

msgid "This profile has been already imported."
msgstr "Tento profil již byl importován."

msgid "Trinity"
msgstr "Trinity"

msgid "Trinity >"
msgstr "Trinity >"

msgid "Uncheck to preserve currently installed packages."
msgstr "Odškrtněte, chcete-li zachovat aktuálně nainstalované balíčky."

msgid "Writing log info ..."
msgstr "Zapisuji informace do protokolu ..."

msgid "Writing profile status ..."
msgstr "Zapisuji stav profilu ..."

msgid "Yes, I really want to install additional DE"
msgstr "Ano, opravdu chci nainstalovat další DE"

msgid "Yes, still apply"
msgstr "Ano, přesto použít"

msgid "You are about to cancel desktop profiler without installing a profile. Are you sure ?"
msgstr "Chystáte se ukončit Desktop Profiler bez instalace profilu. Jste si jisti?"

msgid "You are calling for an alternative desktop installation, but it's not compatible with the profile selected. Please select another profile or desktop."
msgstr "Požadujete instalaci alternativního desktopu, ta ale není s vybraným profilem kompatibilní. Vyberte prosím jiný profil nebo desktop."

msgid "You can now edit the file to your preferences."
msgstr "Soubor nyní můžete upravit podle svých představ."

msgid "some installed applications and packages may be removed as they are not part of the new profile."
msgstr "některé nainstalované aplikace a balíčky mohou být odstraněny, protože nejsou součástí nového profilu."

msgid "Do you really want to remove the selected profile ?"
msgstr "Opravdu chcete vybraný profil odstranit?"

msgid "No Internet connection, the profile cannot be installed."
msgstr "Chybí připojení k internetu, profil nelze nainstalovat."

msgid "Please connect to the Internet and try again."
msgstr "Připojte se prosím k internetu a zkuste to znovu."

msgid "Full featured Desktop with Web Browser, Office Suite and recommended applications set."
msgstr "Plnohodnotné prostředí s webovým prohlížečem, kancelářským balíkem a sadou doporučených aplikací."

msgid "Recommended for regular users. Full featured Desktop with Web Browser, Office Suite and recommended applications set. Installation could take a while."
msgstr "Doporučeno pro běžné uživatele. Plnohodnotné prostředí s webovým prohlížečem, kancelářským balíkem a sadou doporučených aplikací. Instalace může chvíli trvat."

msgid "The Basic Q4OS Desktop with common utilities, system tools and libraries."
msgstr "Základní prostředí Q4OS s běžnými nástroji, systémovými utilitami a knihovnami."

msgid "Starting configuration for users who want to install desktop applications of their choice. Lightweight slim desktop with common utilities, system tools and libraries."
msgstr "Výchozí konfigurace pro uživatele, kteří si chtějí nainstalovat aplikace podle vlastního výběru. Lehké a úsporné prostředí s běžnými nástroji, systémovými utilitami a knihovnami."

msgid "Ultimately minimal desktop, you will be free to set anything up by yourself."
msgstr "Zcela minimální prostředí, vše si můžete nastavit sami."

msgid "For experts only. Ultimately minimal desktop, you will be free to set anything up by yourself."
msgstr "Pouze pro odborníky. Zcela minimální prostředí, vše si můžete nastavit sami."

msgid "Special profile for live media."
msgstr "Zvláštní profil pro živá média."
