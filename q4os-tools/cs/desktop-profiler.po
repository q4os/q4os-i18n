msgid "<p align=justify>This dialog lets you choose an additional desktop environment (DE) to install alongside the default Q4OS desktop.</p><p align=justify>Please do not use this option, unless you are absolutely sure what you are doing.</p>"
msgstr "<p align=justify>Tento dialog umožňuje zvolit další desktopové prostředí (DE), které se nainstaluje vedle výchozího desktopu Q4OS.</p><p align=justify>Tuto volbu prosím nepoužívejte, pokud si nejste naprosto jisti, co děláte.</p>"

msgid "<p>Couldn't open file.</p>"
msgstr "<p>Soubor se nepodařilo otevřít.</p>"

msgid "<p>Do you want to cancel pending operation ?</p>"
msgstr "<p>Chcete zrušit probíhající operaci?</p>"

msgid "<p>Install and set <span style=\"font-weight:600\">KDE Plasma</span> environment as default and leave the Trinity desktop as an option.</p>"
msgstr "<p>Nainstalovat prostředí <span style=\"font-weight:600\">KDE Plasma</span> a nastavit je jako výchozí, desktop Trinity ponechat jako volitelný.</p>"

msgid "<p>Insufficient hardware detected !</p><p>Your CPU lacks SSE2 support, SSE2 is necessary for required software.</p>"
msgstr "<p>Zjištěn nedostatečný hardware!</p><p>Váš procesor nepodporuje SSE2, které požadovaný software vyžaduje.</p>"

msgid "<p>Insufficient hardware detected !</p><p>Your computer is low in hardware resources for profile you have selected, it's not recommended to install the profile.</p>"
msgstr "<p>Zjištěn nedostatečný hardware!</p><p>Váš počítač má pro zvolený profil málo hardwarových prostředků, instalace profilu se nedoporučuje.</p>"

msgid "<p>Keep the <span style=\"font-weight:600\">Trinity</span> desktop as default, no Plasma will be installed. You can start Plasma installation later using the Desktop profiler tool.</p>"
msgstr "<p>Ponechat desktop <span style=\"font-weight:600\">Trinity</span> jako výchozí, Plasma se nenainstaluje. Instalaci prostředí Plasma můžete spustit později nástrojem Desktop Profiler.</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, most likely, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p>"
msgstr "<p>Balíčkovací systém je zaneprázdněn, instalace teď není možná. Nastavení nemůže pokračovat.</p><p>Zámek nejspíše drží probíhající aktualizace systému na pozadí. Pokud je to tak, počkejte chvíli, než balíčkovací systém tyto operace dokončí. Ujistěte se prosím, že neinstalujete jinou aplikaci, a opakujte nastavení za několik minut.</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Varování: Přerušení instalace v této fázi může vést k poškození balíčkovacího systému.</p><p>Opravdu chcete instalační proces nyní přerušit?</p>"

msgid ">"
msgstr ">"

msgid "A profile has been already applied for this system."
msgstr "Pro tento systém již byl použit profil."

msgid "Additional repositories:"
msgstr "Další repozitáře:"

msgid "Another instance of Desktop Profiler is running, leaving ..."
msgstr "Desktop Profiler už běží v jiné instanci, končím ..."

msgid "Apply profile"
msgstr "Použít profil"

msgid "Applying a profile within the live systems isn't supported."
msgstr "Použití profilu v živém systému není podporováno."

msgid "Apt configured, no additional action needed."
msgstr "Apt je nastaven, žádná další akce není potřeba."

msgid "Apt plugin completed, Ok"
msgstr "Modul Apt dokončen, OK"

msgid "Are you really sure to overwrite the previous profile ?"
msgstr "Opravdu chcete přepsat předchozí profil?"

msgid "Cancel"
msgstr "Zrušit"

msgid "Cancel installation"
msgstr "Zrušit instalaci"

msgid "Cancel menu"
msgstr "Zavřít nabídku"

msgid "Choose a new filename to export current status to"
msgstr "Zvolte nový název souboru pro export aktuálního stavu"

msgid "Choose a new filename to save the profile to"
msgstr "Zvolte nový název souboru pro uložení profilu"

msgid "Choose an additional desktop environment to install."
msgstr "Zvolte další desktopové prostředí k instalaci."

msgid "Choose an additional desktop environment to install. Please do not use this option, unless you are absolutely sure what you are doing."
msgstr "Zvolte další desktopové prostředí k instalaci. Tuto volbu prosím nepoužívejte, pokud si nejste naprosto jisti, co děláte."

msgid "Choose desktop environment"
msgstr "Zvolte desktopové prostředí"

msgid "Click to select profile"
msgstr "Klepnutím vyberte profil"

msgid "Configuration file:"
msgstr "Konfigurační soubor:"

msgid "Current desktop status has been saved to profile:"
msgstr "Aktuální stav desktopu byl uložen do profilu:"

msgid "DEB packages to install:"
msgstr "Balíčky DEB k instalaci:"

msgid "Desktop Profiler"
msgstr "Desktop Profiler"

msgid "Desktop Profiler - install progress"
msgstr "Desktop Profiler - průběh instalace"

msgid "Desktop Profiler lets you to choose and apply the most appropriate desktop profile for this computer."
msgstr "Desktop Profiler umožňuje vybrat a použít nejvhodnější desktopový profil pro tento počítač."

msgid "Desktop environment:"
msgstr "Desktopové prostředí:"

msgid "Desktop environments:"
msgstr "Desktopová prostředí:"

msgid "Desktop profiler - select default desktop environment"
msgstr "Desktop Profiler - výběr výchozího desktopového prostředí"

msgid "Do you want to continue ?"
msgstr "Chcete pokračovat?"

msgid "Error: profile not found, file: "
msgstr "Chyba: profil nenalezen, soubor: "

msgid "Exit code: "
msgstr "Návratový kód: "

