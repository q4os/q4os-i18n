msgstr "Spustit instalaci"

msgid "Launching Apt plugin ..."
msgstr "Spouštím modul Apt ..."

msgid "Launching Flatpak plugin ..."
msgstr "Spouštím modul Flatpak ..."

msgid "Next >"
msgstr "Další >"

msgid "No configuration found."
msgstr "Nebyla nalezena žádná konfigurace."

msgid "No profile selected. Select a profile please."
msgstr "Není vybrán žádný profil. Vyberte prosím profil."

msgid "None selected"
msgstr "Nic nevybráno"

