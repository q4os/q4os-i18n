msgstr "Aplikace Flatpak k instalaci:"

msgid "Flatpak plugin completed, Ok"
msgstr "Modul Flatpak dokončen, OK"

msgid "Get snapshot profile"
msgstr "Získat profil ze snímku systému"

msgid "Help"
msgstr "Nápověda"

msgid "If you are not sure, just press <b>[ KDE Plasma ]</b> button to select the recommended option."
msgstr "Pokud si nejste jisti, stiskněte tlačítko <b>[ KDE Plasma ]</b> a zvolte tak doporučenou možnost."

msgid "If you continue, the selected new profile replaces the previous one and system will be configured accordingly."
msgstr "Pokud budete pokračovat, vybraný nový profil nahradí předchozí a systém bude odpovídajícím způsobem nastaven."

msgid "Import a profile"
msgstr "Importovat profil"

msgid "Import local profile"
msgstr "Importovat místní profil"

msgid "Import shared profile"
msgstr "Importovat sdílený profil"

msgid "Initializing environment ..."
msgstr "Inicializace prostředí ..."

msgid "Installation process has requested to logoff this session. Do you want re-login just now ?"
msgstr "Instalační proces požaduje odhlášení této relace. Chcete se nyní znovu přihlásit?"

msgid "KDE Plasma"
msgstr "KDE Plasma"

msgid "KDE Plasma >"
msgstr "KDE Plasma >"

