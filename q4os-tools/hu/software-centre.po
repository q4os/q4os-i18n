msgid "<p>%1 is already installed, do you want to uninstall ?</p>"
msgstr "<p>A(z) %1 már telepítve van, el szeretné távolítani?</p>"

msgid "<p>NVIDIA installation has been detected !</p><p>Actions are disabled during NVIDIA setup, please wait until end of the NVIDIA installation.</p>"
msgstr "<p>NVIDIA telepítést észleltünk !</p><p>Az NVIDIA telepítés során a funkciók le vannak tiltva, kérlek, várj az NVIDIA telepítés végéig.</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, most likely, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p>"
msgstr "<p>A csomagtelepítő rendszer elfoglalt, most nem áll készen a telepítésre. A telepítés nem folytatható.</p><p>A zárolást nagy valószínűséggel a háttérben futó rendszerfrissítések okozzák. Ha ez a helyzet, várnod kell egy pillanatot, amíg a csomagtelepítő rendszer befejezi ezeket a műveleteket.</p><p>Kérlek, győződj meg arról, hogy nem telepítesz más alkalmazást, és ismételd meg a telepítést néhány perc múlva.</p>"

msgid "<p>Select an application to install from the list of featured applications.</p>"
msgstr "<p>Válaszd ki a telepítendő alkalmazást a kiemelt alkalmazások listájából.</p>"

msgid "<p>Virtualbox installation has been detected !</p><p>Actions are disabled during Virtualbox setup, please wait until end of the Virtualbox installation.</p>"
msgstr "<p>A Virtualbox telepítését észleltük !</p><p>A Virtualbox telepítése során a műveletek le vannak tiltva, kérlek, várj a Virtualbox telepítésének végéig.</p>"

msgid "<p>You have applied no desktop profile yet. It's highly recommended to apply a desktop profile before installing applications.</p><p>Please run <b>Desktop Profiler</b> tool to choose and apply a profile.</p>"
msgstr "<p>Még nem alkalmazott asztali profilt. Erősen ajánlott az alkalmazások telepítése előtt egy asztali profilt alkalmazni.</p><p>Kérjük, futtassa a <b>Desktop Profiler</b> eszközt egy profil kiválasztásához és alkalmazásához.</p>"

