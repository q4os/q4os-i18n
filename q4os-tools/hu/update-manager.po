#, c-format
msgid "%n important update available"
msgstr "%n fontos frissítés érhető el"

msgid "%n other update available"
msgstr "%n további frissítés érhető el"

msgid "%n update available"
msgstr "%n frissítés érhető el"

msgid "No updates available."
msgstr "Nincs elérhető frissítés."

msgid "&Configure"
msgstr "&Beállítás"

msgid "&Check for updates"
msgstr "Frissítések &keresése"

msgid "Software Updates"
msgstr "Szoftverfrissítések"

msgid "Reboot required"
msgstr "Újraindítás szükséges"

msgid ""
"System has installed important updates. Please reboot your computer as soon "
"as possible to complete the upgrade."
msgstr "A rendszer fontos frissítéseket telepített. Kérjük, indítsa újra a számítógépét amint lehetséges a frissítés befejezéséhez."

msgid ""
"A reboot is required to complete the update. Reboot now? Any unsaved work "
"will be lost."
msgstr "Az újraindítás szükséges a frissítés befejezéséhez. Újraindítja most? A nem mentett munka elveszik."

msgid "&Reboot now"
msgstr "Újraindítás &most"

msgid "No updates available"
msgstr "Nincs elérhető frissítés"

msgid "&Update now"
msgstr "&Frissítés most"

msgid "Update Manager"
msgstr "Frissítéskezelő"

msgid "Another instance of Update Manager is running, leaving ..."
msgstr "A Frissítéskezelő már fut egy másik példányban, kilépés..."

msgid "Checking apt pinning"
msgstr "Az apt rögzítés ellenőrzése"

msgid "Ok"
msgstr "Ok"

msgid "need to be fixed"
msgstr "javításra szorul"

msgid "Checking Internet connection"
msgstr "Internetkapcsolat ellenőrzése"

msgid "Not available!"
msgstr "Nem érhető el!"

msgid "Update SW database"
msgstr "SW adatbázis frissítése"

msgid "Done"
msgstr "Kész"

msgid "Failed"
msgstr "Sikertelen"

msgid "Listing updates"
msgstr "Frissítések listázása"

msgid "Checking apt database"
msgstr "Az apt adatbázis ellenőrzése"

msgid "Fixing apt database"
msgstr "Az apt adatbázis javítása"

msgid "Downloading packages"
msgstr "Csomagok letöltése"

msgid "Performing upgrade"
msgstr "Frissítés végrehajtása"

msgid "Failed!"
msgstr "Sikertelen!"

msgid "Removing unnecessary packages"
msgstr "A felesleges csomagok eltávolítása"

msgid "Updating Flatpak applications"
msgstr "Flatpak alkalmazások frissítése"

msgid "System update completed successfully."
msgstr "A rendszerfrissítés sikeresen befejeződött."

msgid "Finished :)"
msgstr "Befejezve :)"

msgid "Running Synaptic"
msgstr "Synaptic fut"

msgid "Synaptic package manager is not installed"
msgstr "A Synaptic csomagkezelő nincs telepítve"

msgid "using default updater instead"
msgstr "helyette az alapértelmezett frissítő kerül használatra"

msgid "Show details"
msgstr "Részletek mutatása"

msgid "Cancel"
msgstr "Mégsem"

msgid ""
"You are not allowed to perform system upgrades. You need to be member of "
"administrative group \"sudo\" first, please contact system administrator."
msgstr "Nincs jogosultsága rendszerfrissítések végrehajtásához. Először a „sudo” adminisztratív csoport tagjának kell lennie, kérjük, forduljon a rendszergazdához."

msgid "Checking permissions"
msgstr "Jogosultságok ellenőrzése"

msgid "Checking SW database to be free"
msgstr "SW adatbázis ellenőrzése, hogy szabad legyen"

msgid "Locking SW database"
msgstr "SW adatbázis lezárása"

msgid "System updater has been started.."
msgstr "A rendszerfrissítő elindult.."

msgid ""
"Package system is busy, not ready to install now. Setup cannot continue.\n"
"\n"
"The lock is caused, very probably, by ongoing background system updates. If "
"this is the case, you have to wait a moment for package system to finish "
"these operations.\n"
"\n"
"Please make sure you are not installing another application and repeat setup "
"a few minutes later."
msgstr "A csomagrendszer foglalt, jelenleg nem áll készen a telepítésre. A beállítás nem folytatható.\n\nA zárolást valószínűleg egy folyamatban lévő háttér-rendszerfrissítés okozza. Ha ez a helyzet, várjon egy kicsit, amíg a csomagrendszer befejezi ezeket a műveleteket.\n\nGyőződjön meg róla, hogy nem telepít másik alkalmazást, és ismételje meg a beállítást néhány perc múlva."

msgid "Close"
msgstr "Bezár"

msgid ""
"Update manager has been exited with error code: %1.\n"
"\n"
"Please, try to run Update Manager a few minutes later again."
msgstr "A Frissítéskezelő %1 hibakóddal lépett ki.\n\nKérjük, próbálja meg néhány perc múlva újra futtatni a Frissítéskezelőt."

msgid "Available updates"
msgstr "Elérhető frissítések"

msgid "Additional updates have been detected"
msgstr "További frissítéseket észleltünk"

msgid ""
"Synaptic package manager is not installed so using default updater for "
"now ..."
msgstr "A Synaptic csomagkezelő nincs telepítve, egyelőre az alapértelmezett frissítő kerül használatra..."

msgid "Couldn't run Synaptic. Using default updater for now ..."
msgstr "A Synaptic nem indítható el. Egyelőre az alapértelmezett frissítő kerül használatra..."

msgid "Closing.."
msgstr "Bezárás.."

msgid ""
"Success. The most recent update has been implemented. Reboot is required to "
"complete the upgrade."
msgstr "Siker. A legutóbbi frissítés megtörtént. Az újraindítás szükséges a frissítés befejezéséhez."

msgid ""
"Success. The most recent update has been implemented. Your system is up to "
"date and healthy."
msgstr "Siker. A legutóbbi frissítés megtörtént. A rendszere naprakész és egészséges."

msgid "Finish"
msgstr "Befejezés"

msgid "Waiting"
msgstr "Várakozás"

msgid "Do you want to continue?"
msgstr "Szeretné folytatni?"

msgid "Don't show this dialog again"
msgstr "Ne jelenítse meg újra ezt a párbeszédpanelt"

msgid ""
"If checked, next updates will be performed without user confirmation.\n"
"You can also configure update manager later."
msgstr "Ha be van jelölve, a következő frissítések felhasználói megerősítés nélkül lesznek végrehajtva.\nA Frissítéskezelőt később is beállíthatja."

msgid "No"
msgstr "Nem"

msgid "Yes"
msgstr "Igen"

msgid "Canceled!"
msgstr "Megszakítva!"

msgid ""
"System has received security fixes and important updates.\n"
"\n"
"Please Reboot your computer as soon as possible to complete the upgrade."
msgstr "A rendszer biztonsági javításokat és fontos frissítéseket kapott.\n\nKérjük, indítsa újra a számítógépét amint lehetséges a frissítés befejezéséhez."

msgid "<p>Another instance of Update Manager is running, leaving ...<p>"
msgstr "<p>A Frissítéskezelő egy másik példánya fut, így ...<p>"

msgid ""
"<p>You are not allowed to perform system upgrades. You need to be member of "
"administrative group \"sudo\" first, please contact system administrator.</p>"
msgstr ""
"<p>Nem végezhetsz rendszerfrissítést. Először a „sudo” rendszergazdai "
"csoport tagjának kell lenned, kérlek, fordulj a rendszergazdához.</p>"

msgid ""
"<p>Package system is busy, not ready to install now. Setup cannot continue.</"
"p><p>The lock is caused, very probably, by ongoing background system "
"updates. If this is the case, you have to wait a moment for package system "
"to finish these operations.</p><p>Please make sure you are not installing "
"another application and repeat setup a few minutes later.</p>"
msgstr "<p>A csomagrendszer foglalt, jelenleg nem áll készen a telepítésre. A beállítás nem folytatható.</p><p>A zárolást valószínűleg egy folyamatban lévő háttér-rendszerfrissítés okozza. Ha ez a helyzet, várjon egy kicsit, amíg a csomagrendszer befejezi ezeket a műveleteket.</p><p>Győződjön meg róla, hogy nem telepít másik alkalmazást, és ismételje meg a beállítást néhány perc múlva.</p>"

msgid "Canceled !"
msgstr "Visszavonva !"

msgid "! Reboot required"
msgstr "! Újraindítás szükséges"

msgid ""
"<p>System has received security fixes and important updates.</p><p>Please "
"<b>Reboot</b> your computer as soon as possible to complete the upgrade.</p>"
msgstr ""
"<p>A rendszer biztonsági javításokat és fontos frissítéseket kapott.</"
"p><p>Kérlek, amint lehetséges <b>indítsd újra</b> a számítógépet, a "
"frissítés befejezéséhez.</p>"

msgid "Please, try to run Update Manager a few minutes later again."
msgstr ""
"Kérlek, néhány perccel múlva próbáld meg újra futtatni a Frissítéskezelőt."

msgid "Update manager has been exited with <b>error code: "
msgstr "A frissítéskezelő <b>hibakóddal kilépett: "

msgid "<b>Reboot is required<b> to complete the upgrade."
msgstr "<b>Újraindítás szükséges<b> a frissítés befejezéséhez."

msgid "Success. The most recent update has been implemented."
msgstr "Sikeres. A legutóbbi frissítés végrehajtásra került."

msgid "Your system is up to date and healthy."
msgstr "A rendszer naprakész és egészséges."

msgid "Finish >"
msgstr "Befejezés >"

msgid "Do you want to continue ?"
msgstr "Szeretnéd folytatni?"

msgid "Installing.."
msgstr "Telepítés.."

msgid "Q4OS Update Notifier"
msgstr "Q4OS Frissítésértesítő"

msgid ""
"Please install \"q4os-updater-plasma\" package in order to get better "
"experience."
msgstr "Kérjük, telepítse a „q4os-updater-plasma” csomagot a jobb élmény érdekében."

