msgstr "תהליך ההתקנה ביקש לצאת מהפעלה זו. האם להתחבר מחדש כעת?"

msgid "KDE Plasma"
msgstr "KDE Plasma"

msgid "KDE Plasma >"
msgstr "KDE Plasma >"

msgid "Launch installation"
msgstr "התחלת ההתקנה"

msgid "Launching Apt plugin ..."
msgstr "מפעיל את תוסף Apt ..."

msgid "Launching Flatpak plugin ..."
msgstr "מפעיל את תוסף Flatpak ..."

msgid "Next >"
msgstr "הבא >"

msgid "No configuration found."
msgstr "לא נמצאו הגדרות."

msgid "No profile selected. Select a profile please."
msgstr "לא נבחר פרופיל. נא לבחור פרופיל."

msgid "None selected"
msgstr "לא נבחר דבר"

msgid "Not implemented yet."
msgstr "טרם מומש."

msgid "Note "
msgstr "הערה "

msgid "Ok"
msgstr "אישור"

msgid "Options"
msgstr "אפשרויות"

msgid "Please enter shared profile code, or Internet address:"
msgstr "נא להזין קוד פרופיל משותף או כתובת אינטרנט:"

msgid "Please re-login active session as soon as possible."
msgstr "נא להתחבר מחדש להפעלה הפעילה בהקדם האפשרי."

msgid "Please reboot as soon as possible."
msgstr "נא להפעיל מחדש בהקדם האפשרי."

msgid "Please reboot your computer as soon as possible. Do you want reboot just now ?"
msgstr "נא להפעיל מחדש את המחשב בהקדם האפשרי. האם להפעיל מחדש כעת?"

msgid "Please restart X server as soon as possible."
msgstr "נא להפעיל מחדש את שרת ה-X בהקדם האפשרי."

msgid "Please select default desktop environment."
msgstr "נא לבחור את סביבת שולחן העבודה שתשמש כברירת מחדל."

msgid "Please select default desktop environment. The lightweight and efficient Trinity desktop is installed and pre-configured as default at the moment. Nevertheless, Q4OS installer has autodetected your computer is powerful enough to operate more advanced KDE Plasma desktop environment."
msgstr "נא לבחור את סביבת שולחן העבודה שתשמש כברירת מחדל. שולחן העבודה הקל והיעיל Trinity מותקן כרגע ומוגדר מראש כברירת מחדל. עם זאת, מתקין Q4OS זיהה שהמחשב שלך חזק מספיק כדי להפעיל את סביבת שולחן העבודה המתקדמת יותר KDE Plasma."

msgid "Previous profile:"
msgstr "הפרופיל הקודם:"

msgid "Profile applied, installation successful."
msgstr "הפרופיל הוחל, ההתקנה הצליחה."

msgid "Profile description"
msgstr "תיאור הפרופיל"

msgid "Profile export"
msgstr "ייצוא פרופיל"

msgid "Profile has been imported."
msgstr "הפרופיל יובא."

msgid "Profile has been removed."
msgstr "הפרופיל הוסר."

msgid "Profile info"
msgstr "פרטי הפרופיל"

msgid "Profile name:"
msgstr "שם הפרופיל:"

msgid "QSI applications to install:"
msgstr "יישומי QSI להתקנה:"

msgid "Remote profile not found."
msgstr "הפרופיל המרוחק לא נמצא."

msgid "Remove profile"
msgstr "הסרת פרופיל"

msgid "Remove superfluous packages"
msgstr "הסרת חבילות מיותרות"

msgid "Root permissions needed, exiting ..."
msgstr "נדרשות הרשאות root, יוצא ..."

msgid "Select a profile from the list please."
msgstr "נא לבחור פרופיל מהרשימה."

msgid "Selected profile has been saved to file:"
msgstr "הפרופיל שנבחר נשמר לקובץ:"

msgid "Software profile:"
msgstr "פרופיל תוכנה:"

msgid "Starting profile installation ... "
msgstr "מתחיל בהתקנת הפרופיל ... "

msgid "System profiles cannot be removed."
msgstr "לא ניתן להסיר פרופילי מערכת."

msgid "The lightweight and efficient <b>Trinity</b> desktop is installed and pre-configured as default at the moment. Nevertheless, Q4OS installer has autodetected your computer is powerful enough to operate more advanced <b>KDE Plasma</b> desktop environment."
msgstr "שולחן העבודה הקל והיעיל <b>Trinity</b> מותקן כרגע ומוגדר מראש כברירת מחדל. עם זאת, מתקין Q4OS זיהה שהמחשב שלך חזק מספיק כדי להפעיל את סביבת שולחן העבודה המתקדמת יותר <b>KDE Plasma</b>."

msgid "This profile has been already imported."
msgstr "פרופיל זה כבר יובא."

msgid "Trinity"
msgstr "Trinity"

msgid "Trinity >"
msgstr "Trinity >"

msgid "Uncheck to preserve currently installed packages."
msgstr "יש לבטל את הסימון כדי לשמור על החבילות המותקנות כעת."

msgid "Writing log info ..."
msgstr "כותב פרטי יומן ..."

msgid "Writing profile status ..."
msgstr "כותב את מצב הפרופיל ..."

msgid "Yes, I really want to install additional DE"
msgstr "כן, אני באמת רוצה להתקין סביבת שולחן עבודה נוספת"

msgid "Yes, still apply"
msgstr "כן, להחיל בכל זאת"

msgid "You are about to cancel desktop profiler without installing a profile. Are you sure ?"
msgstr "אתה עומד לסגור את Desktop Profiler מבלי להתקין פרופיל. האם אתה בטוח?"

msgid "You are calling for an alternative desktop installation, but it's not compatible with the profile selected. Please select another profile or desktop."
msgstr "ביקשת להתקין שולחן עבודה חלופי, אך הוא אינו תואם לפרופיל שנבחר. נא לבחור פרופיל או שולחן עבודה אחר."

msgid "You can now edit the file to your preferences."
msgstr "כעת ניתן לערוך את הקובץ לפי העדפותיך."

msgid "some installed applications and packages may be removed as they are not part of the new profile."
msgstr "ייתכן שיישומים וחבילות מותקנים מסוימים יוסרו, מכיוון שאינם חלק מהפרופיל החדש."

msgid "Do you really want to remove the selected profile ?"
msgstr "האם באמת להסיר את הפרופיל הנבחר?"

msgid "No Internet connection, the profile cannot be installed."
msgstr "אין חיבור לאינטרנט, לא ניתן להתקין את הפרופיל."

msgid "Please connect to the Internet and try again."
msgstr "נא להתחבר לאינטרנט ולנסות שוב."

msgid "Full featured Desktop with Web Browser, Office Suite and recommended applications set."
msgstr "שולחן עבודה מלא עם דפדפן אינטרנט, חבילה משרדית ומערך יישומים מומלצים."

msgid "Recommended for regular users. Full featured Desktop with Web Browser, Office Suite and recommended applications set. Installation could take a while."
msgstr "מומלץ למשתמשים רגילים. שולחן עבודה מלא עם דפדפן אינטרנט, חבילה משרדית ומערך יישומים מומלצים. ההתקנה עשויה להימשך זמן מה."

msgid "The Basic Q4OS Desktop with common utilities, system tools and libraries."
msgstr "שולחן העבודה הבסיסי של Q4OS עם כלים נפוצים, כלי מערכת וספריות."

msgid "Starting configuration for users who want to install desktop applications of their choice. Lightweight slim desktop with common utilities, system tools and libraries."
msgstr "תצורת התחלה למשתמשים שרוצים להתקין יישומי שולחן עבודה לפי בחירתם. שולחן עבודה קל ורזה עם כלים נפוצים, כלי מערכת וספריות."

msgid "Ultimately minimal desktop, you will be free to set anything up by yourself."
msgstr "שולחן עבודה מינימלי ביותר, תוכלו להגדיר הכול בעצמכם."

msgid "For experts only. Ultimately minimal desktop, you will be free to set anything up by yourself."
msgstr "למומחים בלבד. שולחן עבודה מינימלי ביותר, תוכלו להגדיר הכול בעצמכם."

msgid "Special profile for live media."
msgstr "פרופיל מיוחד למדיה חיה."
