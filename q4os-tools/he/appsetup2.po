msgstr "בודק את החיבור לאינטרנט ... נכשל !"

msgid "Testing Internet connection ... OK"
msgstr "בודק את החיבור לאינטרנט ... OK"

msgid "Testing installation ..."
msgstr "בודק את ההתקנה בהדמיה ..."

msgid "Testing installation ... Done"
msgstr "בודק את ההתקנה בהדמיה ... הושלם"

msgid "The application doesn't support this system CPU architecture:"
msgstr "היישום אינו תומך בארכיטקטורת המעבד של מערכת זו:"

msgid "The lock can also be caused by a system update in progress in the background. In this case, you need to wait a few minutes for the package system to complete these operations."
msgstr "הנעילה עלולה להיגרם גם מעדכון מערכת המתבצע ברקע. במקרה כזה יש להמתין כמה דקות עד שמערכת החבילות תשלים את הפעולות."

msgid "The post installation check failed, the software may not have been installed correctly."
msgstr "הבדיקה שלאחר ההתקנה נכשלה, ייתכן שהתוכנה לא הותקנה כראוי."

msgid "Trying to recover APT integrity ..."
msgstr "מנסה לשחזר את שלמות APT ..."

msgid "Unsupported distro"
msgstr "הפצה שאינה נתמכת"

msgid "Update Apt database ..."
msgstr "מעדכן את מסד הנתונים של Apt ..."

msgid "Update sw database ..."
msgstr "מעדכן את מסד נתוני התוכנה ..."

msgid "Update sw database ... Done"
msgstr "מעדכן את מסד נתוני התוכנה ... הושלם"

msgid "Update system cache ..."
msgstr "מעדכן את מטמון המערכת ..."

msgid "Update system cache ... Done"
msgstr "מעדכן את מטמון המערכת ... הושלם"

msgid "Upgrade Apt database ..."
msgstr "משדרג חבילות Apt ..."

msgid "Verified ... OK"
msgstr "אומת ... OK"

msgid "Waiting to complete current operation ... Done"
msgstr "ממתין להשלמת הפעולה הנוכחית ... הושלם"

msgid "Warning: cannot terminate proc_lock !"
msgstr "אזהרה: לא ניתן לסיים את proc_lock !"

msgid "Warning: proc_lock is already running, trying to rerun qprocess !"
msgstr "אזהרה: proc_lock כבר פועל, מנסה להפעיל מחדש את qprocess !"

msgid "You are trying to install flatpak based software."
msgstr "בחרת להתקין תוכנה מבוססת flatpak."

msgid "already installed, exiting ..."
msgstr "כבר מותקנת, יוצא ..."

msgid "clean"
msgstr "נקי"

msgid "evaluating..."
msgstr "מעריך..."

msgid "fine"
msgstr "תקין"

msgid "good"
msgstr "תקין"

msgid "installed ... Cancel !"
msgstr "מותקן ... ביטול !"

msgid "installed, newer version to upgrade"
msgstr "מותקן, קיימת גרסה חדשה יותר לשדרוג"

msgid "not installed"
msgstr "לא מותקן"

msgid "not supported, exiting ..."
msgstr "אינה נתמכת, יוצא ..."

