msgstr "מתקין קבצים ... OK"

msgid "Installing package ..."
msgstr "מתקין חבילה ..."

msgid "Insufficient permissions, user isn't member of \"sudo\" group, exiting ..."
msgstr "הרשאות לא מספיקות, המשתמש אינו חבר בקבוצת \"sudo\", יוצא ..."

msgid "License text ..."
msgstr "נוסח הרישיון ..."

msgid "Next >"
msgstr "הבא >"

msgid "No Flathub repository ... Cancel !"
msgstr "אין מאגר Flathub ... ביטול !"

msgid "No Flathub repository, exiting ..."
msgstr "אין מאגר Flathub, יוצא ..."

msgid "Not ready"
msgstr "לא מוכן"

msgid "Package"
msgstr "החבילה"

msgid "Package system ... Busy !"
msgstr "מערכת החבילות ... עסוקה !"

msgid "Package system is busy, another application is being installed just now."
msgstr "מערכת החבילות עסוקה, יישום אחר מותקן ברגע זה."

msgid "Package system not consistent ..."
msgstr "מערכת החבילות אינה עקבית ..."

msgid "Package system still not consistent, canceling installation ..."
msgstr "מערכת החבילות עדיין אינה עקבית, ההתקנה מבוטלת ..."

msgid "Partial update sw database ..."
msgstr "עדכון חלקי של מסד נתוני התוכנה ..."

msgid "Partial update sw database ... Done"
msgstr "עדכון חלקי של מסד נתוני התוכנה ... הושלם"

msgid "Passed OK"
msgstr "עבר בהצלחה"

msgid "Please make sure you are not installing another software and repeat setup few moments later."
msgstr "נא לוודא שלא מותקנת כעת תוכנה אחרת ולחזור על ההתקנה בעוד מספר רגעים."

msgid "Please make sure you are not installing another software and repeat the setup."
msgstr "נא לוודא שלא מותקנת כעת תוכנה אחרת ולחזור על ההתקנה."

msgid "Postinstall operations ..."
msgstr "פעולות לאחר ההתקנה ..."

msgid "Postinstall operations ... Done"
msgstr "פעולות לאחר ההתקנה ... הושלם"

msgid "Postinstall operations, additional commands ..."
msgstr "פעולות לאחר ההתקנה, פקודות נוספות ..."

msgid "Preparing installation files ..."
msgstr "מכין קובצי התקנה ..."

msgid "Preparing installation files ... OK"
msgstr "מכין קובצי התקנה ... OK"

msgid "Prerun script requested exit. Exit code:"
msgstr "סקריפט ההכנה ביקש לצאת. קוד יציאה:"

msgid "Press Page Down to see the rest of agreement."
msgstr "יש ללחוץ על Page Down כדי לראות את המשך ההסכם."

msgid "Q4OS Install System v1.0"
msgstr "מערכת ההתקנה של Q4OS v1.0"

msgid "Recovered ... OK"
msgstr "שוחזר ... OK"

msgid "Registering application ... OK"
msgstr "רושם את היישום ... OK"

msgid "Root permissions needed, exiting ..."
msgstr "נדרשות הרשאות root, יוצא ..."

msgid "Running custom scripts ..."
msgstr "מריץ סקריפטים מותאמים ..."

