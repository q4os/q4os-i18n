msgstr "מריץ סקריפטים מותאמים ... הושלם"

msgid "Searching for language packages ..."
msgstr "מחפש חבילות שפה ..."

msgid "Searching for language packages ... Done"
msgstr "מחפש חבילות שפה ... הושלם"

msgid "Setup action:"
msgstr "פעולת ההתקנה:"

msgid "Setup action:  "
msgstr "פעולת ההתקנה:  "

msgid "Setup logfile \"%1\" cannot be saved !"
msgstr "לא ניתן לשמור את קובץ יומן ההתקנה \"%1\" !"

msgid "Setup messages were recorded into logfile:"
msgstr "הודעות ההתקנה נרשמו לקובץ היומן:"

msgid "Setup wizard"
msgstr "אשף התקנה"

msgid "Temporary setup directory not deleted."
msgstr "תיקיית ההתקנה הזמנית לא נמחקה."

msgid "Testing Internet connection ..."
msgstr "בודק את החיבור לאינטרנט ..."

