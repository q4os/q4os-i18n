msgstr "מעתיק חבילות מערכת ..."

msgid "Copying system packages ... Done"
msgstr "מעתיק חבילות מערכת ... הושלם"

msgid "Could not initialize, incorrect data header !"
msgstr "לא ניתן לאתחל, כותרת הנתונים שגויה !"

msgid "Could not initialize, incorrect data header."
msgstr "לא ניתן לאתחל, כותרת הנתונים שגויה."

msgid "Could not run Q4OS low-level apt utilities ! It is a serious problem, breaking the installation ..."
msgstr "לא ניתן להפעיל את כלי ה-apt הבסיסיים של Q4OS ! זו בעיה חמורה, ההתקנה נעצרת ..."

msgid "Detecting operating system version"
msgstr "מזהה את גרסת מערכת ההפעלה"

