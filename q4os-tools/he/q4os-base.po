#, sh-format
msgid "<b>Press Yes</b> button to run auto-install wizard, which will guide you through installation process of the latest stable version with automatic updates. Otherwise click No and use Konqueror as a default option. It is possible to get ${APF1} installer from Q4OS Software Centre anytime."
msgstr "<b>לחצו על כן</b> כדי להפעיל את אשף ההתקנה האוטומטית, שינחה אתכם בתהליך ההתקנה של הגרסה היציבה העדכנית עם עדכונים אוטומטיים. אחרת לחצו על לא והשתמשו ב-Konqueror כברירת מחדל. ניתן לקבל את מתקין ${APF1} ממרכז התוכנה של Q4OS בכל עת."

#, sh-format
msgid "<b>Q4OS optimized</b> ${APD} is preferred to original Oracle's CD, to achieve the best performance. This setup will download and auto-install all the needed just now."
msgstr "כדי להשיג את הביצועים הטובים ביותר, ${APD} <b>המותאם ל-Q4OS</b> עדיף על התקליטור המקורי של Oracle. התקנה זו תוריד ותתקין אוטומטית את כל הנדרש כעת."

#, sh-format
msgid "<b>Warning</b>"
msgstr "<b>אזהרה</b>"

#, sh-format
msgid "Asus Eee PC laptop detected, extra configuration will be performed."
msgstr "זוהה מחשב נייד Asus Eee PC, תבוצע הגדרה נוספת."

#, sh-format
msgid "Broadcom WiFi driver"
msgstr "מנהל התקן WiFi של Broadcom"

#, sh-format
msgid "Check Internet connection, please."
msgstr "אנא בדקו את החיבור לאינטרנט."

#, sh-format
msgid "Click \"Ok\" button to show the MenuEditor window."
msgstr "לחצו על הכפתור \"Ok\" כדי להציג את חלון עורך התפריט."

#, sh-format
msgid "Click OK to get login screen now."
msgstr "לחצו על OK כדי לעבור למסך הכניסה כעת."

#, sh-format
msgid "Click OK to run WiFi connection tool to create a network connection."
msgstr "לחצו על OK כדי להפעיל את כלי החיבור ל-WiFi וליצור חיבור רשת."

#, sh-format
msgid "Click Ok to reboot your computer now."
msgstr "לחצו על Ok כדי להפעיל מחדש את המחשב כעת."

#, sh-format
msgid "Configuring desktop theme ..."
msgstr "מגדיר את ערכת הנושא של שולחן העבודה ..."

#, sh-format
msgid "Configuring the profile ..."
msgstr "מגדיר את הפרופיל ..."

#, sh-format
msgid "Configuring the system ..."
msgstr "מגדיר את המערכת ..."

#, sh-format
msgid "Congratulations, setup has finished."
msgstr "ברכות, ההתקנה הסתיימה."

#, sh-format
msgid "Current system language: <b>English</b>"
msgstr "שפת המערכת הנוכחית: <b>אנגלית</b>"

#, sh-format
msgid "Default language: <b>${LANC}</b>"
msgstr "שפת ברירת המחדל: <b>${LANC}</b>"

#, sh-format
msgid "Display setup"
msgstr "הגדרת תצוגה"

#, sh-format
msgid "Do you want to continue ?"
msgstr "האם ברצונכם להמשיך ?"

#, sh-format
msgid "Do you want to install <b>${APF1}</b> just now ?"
msgstr "האם ברצונכם להתקין את <b>${APF1}</b> כעת ?"

#, sh-format
msgid "Do you want to keep English as default system language ?"
msgstr "האם ברצונכם להשאיר את האנגלית כשפת ברירת המחדל של המערכת ?"

#, sh-format
msgid "Do you want to open it now ?"
msgstr "האם ברצונכם לפתוח אותו כעת ?"

#, sh-format
msgid "Download failed !"
msgstr "ההורדה נכשלה !"

#, sh-format
msgid "Downloading language pack, please wait ..."
msgstr "מוריד חבילת שפה, אנא המתינו ..."

#, sh-format
msgid "Drivers"
msgstr "מנהלי התקן"

#, sh-format
msgid "For more detailed info read Q4OS documentation at https://www.q4os.org"
msgstr "למידע מפורט יותר קראו את התיעוד של Q4OS בכתובת https://www.q4os.org"

#, sh-format
msgid "Generating system wide locales, please wait ..."
msgstr "יוצר הגדרות אזוריות לכל המערכת, אנא המתינו ..."

#, sh-format
msgid "IBM Thinkpad R51 laptop detected, extra configuration will be performed."
msgstr "זוהה מחשב נייד IBM Thinkpad R51, תבוצע הגדרה נוספת."

#, sh-format
msgid "If you want to get the best experience and latest Internet technologies, we recommend you to install <b>${APF1}</b> within Q4OS system."
msgstr "אם ברצונכם ליהנות מהחוויה הטובה ביותר ומטכנולוגיות האינטרנט העדכניות, אנו ממליצים להתקין את <b>${APF1}</b> במערכת Q4OS."

#, sh-format
msgid "Install wizard"
msgstr "אשף התקנה"

#, sh-format
msgid "Installation has not completed, package system is busy. Try it few minutes later please."
msgstr "ההתקנה לא הושלמה, מערכת החבילות עסוקה. אנא נסו שוב בעוד מספר דקות."

#, sh-format
msgid "Installation has not completed, package system is busy. You can easily install language pack later, using a desktop icon."
msgstr "ההתקנה לא הושלמה, מערכת החבילות עסוקה. ניתן להתקין את חבילת השפה בקלות מאוחר יותר באמצעות סמל בשולחן העבודה."

#, sh-format
msgid "Installer needs to download packages from Q4OS Internet resources, but no info could be retrieved. You will be asked for ${APD} installation at the next login, or you can install anytime from Software centre."
msgstr "המתקין צריך להוריד חבילות ממשאבי האינטרנט של Q4OS, אך לא ניתן היה לקבל מידע. תישאלו על התקנת ${APD} בכניסה הבאה, או שתוכלו להתקין בכל עת ממרכז התוכנה."

#, sh-format
msgid "Installer needs to download packages from Q4OS Internet resources, but no info could be retrieved. You will be prompted for ${APF1} installation at next Konqueror run, or you can install anytime from Q4OS Software Centre."
msgstr "המתקין צריך להוריד חבילות ממשאבי האינטרנט של Q4OS, אך לא ניתן היה לקבל מידע. תתבקשו להתקין את ${APF1} בהפעלה הבאה של Konqueror, או שתוכלו להתקין בכל עת ממרכז התוכנה של Q4OS."

#, sh-format
msgid "Language"
msgstr "שפה"

#, sh-format
msgid "Language <b>${LANC}</b> has been added to system."
msgstr "השפה <b>${LANC}</b> נוספה למערכת."

#, sh-format
msgid "Language pack"
msgstr "חבילת שפה"

#, sh-format
msgid "Live media detected. Printers management may be limited within the live media environment. It will be fully available after Q4OS installation."
msgstr "זוהתה מדיה חיה. ניהול המדפסות עשוי להיות מוגבל בסביבת המדיה החיה. הוא יהיה זמין במלואו לאחר התקנת Q4OS."

#, sh-format
msgid "NVIDIA graphics driver"
msgstr "מנהל התקן גרפי של NVIDIA"

#, sh-format
msgid "Newly created items will appear in the start menu <b>after closing</b> the MenuEditor window."
msgstr "פריטים חדשים יופיעו בתפריט ההתחלה <b>לאחר סגירת</b> חלון עורך התפריט."

#, sh-format
msgid "No desktop profile has been applied yet. It's highly recommended to run <b>Desktop Profiler</b> tool and apply one of available profiles as soon as possible."
msgstr "עדיין לא הוחל פרופיל שולחן עבודה. מומלץ מאוד להפעיל את הכלי <b>Desktop Profiler</b> ולהחיל אחד מהפרופילים הזמינים בהקדם האפשרי."

#, sh-format
msgid "Package system is busy now, setup cannot continue. You will be asked for ${APD} installation at the next login, or you can install anytime from Software centre."
msgstr "מערכת החבילות עסוקה כעת, ההתקנה אינה יכולה להמשיך. תישאלו על התקנת ${APD} בכניסה הבאה, או שתוכלו להתקין בכל עת ממרכז התוכנה."

#, sh-format
msgid "Package system is busy now, setup cannot continue. You will be asked for ${APF1} installation later again, or you can install anytime from Q4OS Software Centre."
msgstr "מערכת החבילות עסוקה כעת, ההתקנה אינה יכולה להמשיך. תישאלו שוב על התקנת ${APF1} מאוחר יותר, או שתוכלו להתקין בכל עת ממרכז התוכנה של Q4OS."

#, sh-format
msgid "Package system is busy now, some other setup is running ! You will be asked for ${APF1} installation later again, or you can install anytime from Q4OS Software Centre."
msgstr "מערכת החבילות עסוקה כעת, התקנה אחרת פועלת ! תישאלו שוב על התקנת ${APF1} מאוחר יותר, או שתוכלו להתקין בכל עת ממרכז התוכנה של Q4OS."

#, sh-format
msgid "Please login again to take changes effect."
msgstr "אנא התחברו מחדש כדי שהשינויים ייכנסו לתוקף."

#, sh-format
msgid "Printing subsystem is now deactivated, you need to install <b>CUPS layer and printer driver</b> first. If you want to activate printing subsystem and full set of drivers, install following packages:"
msgstr "מערכת ההדפסה מושבתת כעת, יש להתקין תחילה את <b>שכבת CUPS ומנהל התקן למדפסת</b>. אם ברצונכם להפעיל את מערכת ההדפסה ואת מערך מנהלי ההתקן המלא, התקינו את החבילות הבאות:"

#, sh-format
msgid "Q4OS autodetected <b>drivers</b> available <b>!</b>"
msgstr "Q4OS זיהתה אוטומטית <b>מנהלי התקן</b> זמינים <b>!</b>"

#, sh-format
msgid "Select your language:"
msgstr "בחרו את השפה שלכם:"

#, sh-format
msgid "Setup cannot continue ..."
msgstr "ההתקנה אינה יכולה להמשיך ..."

#, sh-format
msgid "Setup cannot continue."
msgstr "ההתקנה אינה יכולה להמשיך."

#, sh-format
msgid "Sound card not detected, system sound was disabled."
msgstr "לא זוהה כרטיס קול, צלילי המערכת הושבתו."

#, sh-format
msgid "Start menu structure consists of two logical parts mixed, the <b>system global and user part</b>. You can edit, delete and add custom menu entries for the user part only, global menu entries are not visible in the MenuEditor."
msgstr "מבנה תפריט ההתחלה מורכב משני חלקים לוגיים משולבים, <b>החלק הגלובלי של המערכת וחלק המשתמש</b>. ניתן לערוך, למחוק ולהוסיף פריטי תפריט מותאמים אישית בחלק המשתמש בלבד, פריטי התפריט הגלובליים אינם מוצגים בעורך התפריט."

#, sh-format
msgid "System is ready to download and install ${LANC} language pack, you need an active Internet link."
msgstr "המערכת מוכנה להוריד ולהתקין את חבילת השפה ${LANC}, נדרש חיבור אינטרנט פעיל."

#, sh-format
msgid "Thank you for using Konqueror web browser. Konqueror is a minimalist and very fast browser for users who need lightweight Internet access."
msgstr "תודה שאתם משתמשים בדפדפן Konqueror. Konqueror הוא דפדפן מינימליסטי ומהיר מאוד למשתמשים הזקוקים לגישה קלת משקל לאינטרנט."

#, sh-format
msgid "Trinity session not detected. Please run this tool within Trinity desktop."
msgstr "לא זוהתה הפעלת Trinity. אנא הפעילו כלי זה בתוך שולחן העבודה Trinity."

#, sh-format
msgid "Unable to download ${APD}, check Internet connection, please."
msgstr "לא ניתן להוריד את ${APD}, אנא בדקו את החיבור לאינטרנט."

#, sh-format
msgid "Unable to download, check Internet connection please. You can easily install language pack later, using a desktop icon."
msgstr "לא ניתן להוריד, אנא בדקו את החיבור לאינטרנט. ניתן להתקין את חבילת השפה בקלות מאוחר יותר באמצעות סמל בשולחן העבודה."

#, sh-format
msgid "Unable to update, check Internet connection please."
msgstr "לא ניתן לעדכן, אנא בדקו את החיבור לאינטרנט."

#, sh-format
msgid "Wireless network card detected, WiFi support enabled."
msgstr "זוהה כרטיס רשת אלחוטי, התמיכה ב-WiFi הופעלה."

#, sh-format
msgid "Would you like to be <b>notified at the next login</b> ? If you say \"No\", this dialog never appears again. You can install ${APD} anytime from <b>Software centre</b>."
msgstr "האם ברצונכם לקבל <b>הודעה בכניסה הבאה</b> ? אם תענו \"לא\", חלון זה לא יופיע שוב. ניתן להתקין את ${APD} בכל עת מ<b>מרכז התוכנה</b>."

#, sh-format
msgid "Would you like to be <b>notified at the next login</b> ? If you say \"No\", this dialog never appears again. You can review the drivers anytime in the <b>Hardware info</b> tool."
msgstr "האם ברצונכם לקבל <b>הודעה בכניסה הבאה</b> ? אם תענו \"לא\", חלון זה לא יופיע שוב. ניתן לעיין במנהלי ההתקן בכל עת בכלי <b>מידע על החומרה</b>."

#, sh-format
msgid "Would you like to be notified later ?"
msgstr "האם ברצונכם לקבל הודעה מאוחר יותר ?"

#, sh-format
msgid "Would you like to install the language right now ?"
msgstr "האם ברצונכם להתקין את השפה כעת ?"

#, sh-format
msgid "Wow, Q4OS autodetected, that it is running inside <b>${APF}</b> host <b>!</b>"
msgstr "Q4OS זיהתה אוטומטית שהיא פועלת בתוך מארח <b>${APF}</b> <b>!</b>"

#, sh-format
msgid "Yes, this is the right way to test Q4OS operating system. It is <b>highly recommended</b> to install <b>${APD}</b> within this virtual machine. It will be possible to display in fullscreen mode, use ${APF} networking, mouse drivers and other functionality."
msgstr "כן, זו הדרך הנכונה לבחון את מערכת ההפעלה Q4OS. <b>מומלץ מאוד</b> להתקין את <b>${APD}</b> במכונה וירטואלית זו. כך ניתן יהיה להציג במסך מלא, להשתמש ברשת של ${APF}, במנהלי התקן לעכבר ובתכונות נוספות."

#, sh-format
msgid "You are going to edit Start Menu."
msgstr "אתם עומדים לערוך את תפריט ההתחלה."

#, sh-format
msgid "You can review and install them in the <b>Hardware info</b> tool, on its <b>Drivers</b> tab."
msgstr "ניתן לעיין בהם ולהתקין אותם בכלי <b>מידע על החומרה</b>, בלשונית <b>מנהלי התקן</b>."

#, sh-format
msgid "You may want to enlarge text and widgets size to improve readability. Click OK to run a configuration tool for screen setup and scaling."
msgstr "ייתכן שתרצו להגדיל את הטקסט והפקדים כדי לשפר את הקריאות. לחצו על OK כדי להפעיל כלי להגדרת המסך וקנה המידה."

#, sh-format
msgid "You will be able to create new custom submenus/folders structure and fill it with desired menu entries. You can create new shortcuts using right mouse click, or drag&drop icons from start menu or desktop into the MenuEditor window."
msgstr "תוכלו ליצור מבנה מותאם אישית של תפריטי משנה ותיקיות ולמלא אותו בפריטי התפריט הרצויים. ניתן ליצור קיצורי דרך חדשים בלחיצה ימנית בעכבר, או בגרירת סמלים מתפריט ההתחלה או משולחן העבודה אל חלון עורך התפריט."

#, sh-format
msgid "download"
msgstr "הורדה"

#, sh-format
msgid "downloading ..."
msgstr "מוריד ..."

#, sh-format
msgid "message"
msgstr "הודעה"
