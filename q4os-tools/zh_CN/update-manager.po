msgstr "更新管理器的另一个实例正在运行,即将退出……"

msgid "Checking apt pinning"
msgstr "正在检查 apt 锁定版本设置"

msgid "Ok"
msgstr "确定"

msgid "need to be fixed"
msgstr "需要修复"

msgid "Checking Internet connection"
msgstr "正在检查网络连接"

