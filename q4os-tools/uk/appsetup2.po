msgid "< Back"
msgstr "< Назад"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Швидкі перевірки системи</b><br>&nbsp;&nbsp;&nbsp;Система перевіряє середовище встановлення"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Отримання дозволів</b><br>&nbsp;&nbsp;&nbsp;Система запитує дозволи на встановлення"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Встановлення</b><br>&nbsp;&nbsp;&nbsp;Зачекайте, програмне забезпечення встановлюється"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Ліцензійна угода</b><br>&nbsp;&nbsp;&nbsp;Перед встановленням ознайомтеся з умовами ліцензії"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Завершення роботи майстра встановлення _SUBST_SWNAME_</h2><br></p>\n<p>Програму _SUBST_SWNAME_ встановлено на ваш комп'ютер.<br></p>\n<p>Натисніть «Завершити», щоб закрити майстер.<br><br><br><br><br></p>\n<p>Відвідайте сайт _SUBST_SWNAME_, щоб дізнатися новини, відповіді на поширені запитання та отримати підтримку</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr "<p><h2>Ласкаво просимо до майстра встановлення _SUBST_SWNAME_</h2></p>\n<p>Цей майстер допоможе вам встановити програму _SUBST_SWNAME_.</p>\n<p>Натисніть «Далі», щоб продовжити.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Виявлена версія операційної системи: Q4OS <b>%1</b>.</p><p>Для встановлення %2 потрібна Q4OS не новіша за <b>%3</b>.</p><p> Скасування встановлення ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Виявлена версія операційної системи: Q4OS <b>%1</b>.</p><p>Для встановлення %2 потрібна Q4OS не старіша за <b>%3</b>.</p><p> Скасування встановлення ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Не вдалося визначити версію системи Q4OS.</p><p>Скасування встановлення ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Початкові дані неповні !</p><p> Скасування встановлення ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>З'єднання з Інтернетом неактивне або дуже повільне. Програмі встановлення потрібно завантажити пакунки з інтернет-джерел Q4OS. Встановлення неможливо продовжити ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Немає прав доступу до системи, ви не входите до групи \"sudo\" !</p><p> Скасування встановлення ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>Система пакунків зайнята, зараз встановлення неможливе. Встановлення неможливо продовжити.</p><p>Блокування, найімовірніше, спричинене оновленням системи у фоновому режимі. У такому разі потрібно трохи зачекати, доки система пакунків завершить ці операції. Переконайтеся, що ви не встановлюєте іншу програму, і повторіть встановлення за кілька хвилин.</p><p>Очищення та скасування ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Система пакунків у неузгодженому стані, її потрібно відновити вручну. Зараз встановлення неможливо продовжити.</p><p>Очищення та скасування ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Не вдалося завантажити пакунки, перевірте з'єднання з Інтернетом. На жаль, зараз встановлення неможливе.</p><p>Очищення та скасування ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Пробне встановлення не вдалося, на жаль, зараз встановлення неможливе.</p><p>Очищення та скасування ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Увага: скасування встановлення на цьому етапі може призвести до збою системи пакунків.</p><p>Ви справді хочете перервати встановлення зараз ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Встановлення не можна запускати від імені root !</p><p> Скасування встановлення ...</p>"

