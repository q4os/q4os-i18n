msgid "< Back"
msgstr "< Voltar"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Verificações rápidas do sistema</b><br>&nbsp;&nbsp;&nbsp;O sistema está verificando o ambiente de instalação"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Obter permissões</b><br>&nbsp;&nbsp;&nbsp;O sistema solicita permissões de instalação"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Instalando</b><br>&nbsp;&nbsp;&nbsp;Aguarde enquanto o software é instalado"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Contrato de licença</b><br>&nbsp;&nbsp;&nbsp;Leia os termos da licença antes de instalar"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Concluindo o assistente de instalação do _SUBST_SWNAME_</h2><br></p>\n<p>O software _SUBST_SWNAME_ foi instalado no seu computador.<br></p>\n<p>Clique em Concluir para fechar o assistente.<br><br><br><br><br></p>\n<p>Visite o site do _SUBST_SWNAME_ para as últimas notícias, perguntas frequentes e suporte</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr ""
"<p><h2>Bem-vindo ao assistente de configuração _SUBST_SWNAME_</h2></p>\n"
"<p>Este assistente irá guiá-lo através da instalação da aplicação _SUBST_SWNAME_.</p>\n"
"<p>Clique em Avançar para continuar.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Versão do sistema operacional detectada: Q4OS <b>%1</b>.</p><p>Esta instalação do %2 requer no máximo o Q4OS <b>%3</b>.</p><p> Cancelando a instalação ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Versão do sistema operacional detectada: Q4OS <b>%1</b>.</p><p>Esta instalação do %2 requer no mínimo o Q4OS <b>%3</b>.</p><p> Cancelando a instalação ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Não foi possível detectar a versão do sistema Q4OS.</p><p>Cancelando a instalação ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Dados iniciais incompletos !</p><p> Cancelando a instalação ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>A conexão com a Internet está inativa ou muito lenta. O instalador precisa baixar os pacotes da aplicação das fontes da Internet do Q4OS. A instalação não pode continuar ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Sem permissões de acesso ao sistema, você não está no grupo \"sudo\" !</p><p> Cancelando a instalação ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>O sistema de pacotes está ocupado, não está pronto para instalar agora. O programa de instalação não pode continuar.</p><p>O bloqueio é causado, muito provavelmente, por atualizações contínuas do sistema em segundo plano. Se esse for o caso, você deve aguardar um momento para que o sistema de pacotes conclua essas operações. Certifique-se de que não está instalando outra aplicação e repita a configuração alguns minutos depois.</p><p>Limpando e cancelando agora ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>O sistema de pacotes está em estado não consistente, precisa ser recuperado manualmente. A instalação não pode continuar agora.</p><p>Limpando e cancelando ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Os pacotes não puderam ser baixados, verifique a sua conexão com a Internet. Desculpe, não posso instalar agora.</p><p>Limpando e cancelando ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>A simulação não foi bem-sucedida, desculpe, não posso instalar agora.</p><p>Limpando e cancelando ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Aviso: Cancelar a instalação durante esta fase pode resultar em falha do sistema de pacotes.</p><p>Tem certeza de que deseja interromper o processo de instalação agora ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Você não pode executar a instalação como root !</p><p> Cancelando a instalação ...</p>"

