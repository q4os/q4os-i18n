msgid "<font size=\"4\"><p align=justify><b>Welcome to Q4OS</b>, fast and powerful desktop operating system focused on long-term stability, reliability and classic style user interface.</p><p align=justify>Q4OS is installed as a very basic and clean desktop environment with the minimal software kit. Now it's the right time to adjust your new desktop, you might want to make use of tweaking shortcuts below.</p></font>"
msgstr "<font size=\"4\"><p align=justify><b>Q4OS'a hoş geldiniz</b>: uzun süreli kararlılığa, güvenilirliğe ve klasik tarzda bir kullanıcı arayüzüne odaklanan hızlı ve güçlü bir masaüstü işletim sistemi.</p><p align=justify>Q4OS, en az yazılım setiyle çok temel ve temiz bir masaüstü ortamı olarak kuruldu. Yeni masaüstünüzü ayarlamanın tam zamanı; aşağıdaki ince ayar kısayollarından yararlanabilirsiniz.</p></font>"

msgid "<font size=\"4\"><p>Bypass login screen and login without entering your password after the system boot.</p></font>"
msgstr "<font size=\"4\"><p>Sistem açıldıktan sonra giriş ekranını atlayın ve parola girmeden oturum açın.</p></font>"

msgid "<font size=\"4\"><p>Desktop Profiler will automatically install and configure set of additional Applications and tools, all in single click.</p><p>You will be allowed to select between different desktop profiles.</p></font>"
msgstr "<font size=\"4\"><p>Desktop Profiler, ek uygulama ve araçlardan oluşan bir seti tek tıkla otomatik olarak kurup yapılandırır.</p><p>Farklı masaüstü profilleri arasından seçim yapabilirsiniz.</p></font>"

msgid "<font size=\"4\"><p>Other useful configuration options.</p></font>"
msgstr "<font size=\"4\"><p>Diğer yararlı yapılandırma seçenekleri.</p></font>"

msgid "<font size=\"4\"><p>Run an interactive script to install extra collection of professional quality codecs.</p><p>Media players such as VLC or Mplayer make use of these codecs in order to provide support for playback of DVD and multimedia files encoded through these codecs.</p></font>"
msgstr "<font size=\"4\"><p>Profesyonel kalitede ek bir kodek koleksiyonu kurmak için etkileşimli bir betik çalıştırın.</p><p>VLC veya Mplayer gibi medya oynatıcılar, DVD'leri ve bu kodeklerle kodlanmış çoklu ortam dosyalarını oynatmak için bu kodekleri kullanır.</p></font>"

msgid "<font size=\"4\"><p>Switch to alternative Kickoff Start menu.</p><p>Well arranged, modern style start menu offers search bar, favorites tab, history and more.</p></font>"
msgstr "<font size=\"4\"><p>Alternatif Kickoff Başlat menüsüne geçin.</p><p>Düzenli, modern tarzdaki başlat menüsü arama çubuğu, sık kullanılanlar sekmesi, geçmiş ve daha fazlasını sunar.</p></font>"

msgid "<font size=\"4\"><p>You will be directed to Q4OS web resources to download and install standalone useful applications.</p></font>"
msgstr "<font size=\"4\"><p>Yararlı bağımsız uygulamaları indirip kurmak için Q4OS web kaynaklarına yönlendirileceksiniz.</p></font>"

msgid "<p>Automatic login is now disabled.</p>"
msgstr "<p>Otomatik oturum açma artık devre dışı.</p>"

msgid "<p>Automatic login is now enabled.</p>"
msgstr "<p>Otomatik oturum açma artık etkin.</p>"

msgid "<p>Desktop effects have been disabled.</p>"
msgstr "<p>Masaüstü efektleri devre dışı bırakıldı.</p>"

msgid "<p>Desktop effects have been enabled. Please login again to take changes effect.</p>"
msgstr "<p>Masaüstü efektleri etkinleştirildi. Değişikliklerin geçerli olması için lütfen yeniden oturum açın.</p>"

msgid "<p>Do you want to enable Automatic login ?</p>"
msgstr "<p>Otomatik oturum açmayı etkinleştirmek istiyor musunuz?</p>"

msgid "<p>Do you want to switch the Start Menu ?</p>"
msgstr "<p>Başlat Menüsünü değiştirmek istiyor musunuz?</p>"

msgid "<p>Start Menu is now set to Bourbon style.</p>"
msgstr "<p>Başlat Menüsü artık Bourbon tarzına ayarlı.</p>"

msgid "<p>Start Menu is now set to Classic style.</p>"
msgstr "<p>Başlat Menüsü artık Klasik tarzına ayarlı.</p>"

msgid "<p>Start Menu is now set to Kickoff style.</p>"
msgstr "<p>Başlat Menüsü artık Kickoff tarzına ayarlı.</p>"

msgid "<p>This action is available for Trinity and Plasma desktops only.</p>"
msgstr "<p>Bu eylem yalnızca Trinity ve Plasma masaüstlerinde kullanılabilir.</p>"

msgid "<p>This action is available for Trinity desktop only.</p>"
msgstr "<p>Bu eylem yalnızca Trinity masaüstünde kullanılabilir.</p>"

