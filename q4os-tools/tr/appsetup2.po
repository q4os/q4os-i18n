msgstr "<b>İzinleri al</b><br>&nbsp;&nbsp;&nbsp;Sistem kurulum izinlerini istiyor"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Kuruluyor</b><br>&nbsp;&nbsp;&nbsp;Yazılım kurulurken lütfen bekleyin"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Lisans Sözleşmesi</b><br>&nbsp;&nbsp;&nbsp;Kurulumdan önce lütfen lisans koşullarını okuyun"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>_SUBST_SWNAME_ kurulum sihirbazı tamamlanıyor</h2><br></p>\n<p>_SUBST_SWNAME_ yazılımı bilgisayarınıza kuruldu.<br></p>\n<p>Sihirbazı kapatmak için Bitir'e tıklayın.<br><br><br><br><br></p>\n<p>En son haberler, sık sorulan sorular ve destek için _SUBST_SWNAME_ web sitesini ziyaret edin</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr "<p><h2>_SUBST_SWNAME_ kurulum sihirbazına hoş geldiniz</h2></p>\n<p>Bu sihirbaz, _SUBST_SWNAME_ uygulamasının kurulumunda size yol gösterecek.</p>\n<p>Devam etmek için İleri'ye tıklayın.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Algılanan işletim sistemi sürümü: Q4OS <b>%1</b>.</p><p>Bu %2 kurulumu en fazla Q4OS <b>%3</b> gerektirir.</p><p> Kurulum iptal ediliyor ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Algılanan işletim sistemi sürümü: Q4OS <b>%1</b>.</p><p>Bu %2 kurulumu en az Q4OS <b>%3</b> gerektirir.</p><p> Kurulum iptal ediliyor ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Q4OS sistem sürümü algılanamadı.</p><p>Kurulum iptal ediliyor ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Başlangıç verileri eksik !</p><p> Kurulum iptal ediliyor ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>İnternet bağlantısı etkin değil veya çok yavaş. Kurucunun uygulama paketlerini Q4OS İnternet kaynaklarından indirmesi gerekiyor. Kurulum devam edemiyor ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Sisteme erişim izni yok, \"sudo\" grubunda değilsiniz !</p><p> Kurulum iptal ediliyor ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>Paket sistemi meşgul, şu anda kurulum yapılamıyor. Kurulum devam edemiyor.</p><p>Kilit büyük olasılıkla arka planda süren sistem güncellemelerinden kaynaklanıyor. Bu durumda paket sisteminin bu işlemleri bitirmesi için biraz beklemeniz gerekir. Lütfen başka bir uygulama kurmadığınızdan emin olun ve kurulumu birkaç dakika sonra yineleyin.</p><p>Temizleniyor ve iptal ediliyor ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Paket sistemi tutarsız durumda, elle onarılması gerekiyor. Kurulum şu anda devam edemiyor.</p><p>Temizleniyor ve iptal ediliyor ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Paketler indirilemedi, lütfen İnternet bağlantınızı denetleyin. Üzgünüm, şu anda kurulum yapılamıyor.</p><p>Temizleniyor ve iptal ediliyor ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Deneme kurulumu başarısız, üzgünüm, şu anda kurulum yapılamıyor.</p><p>Temizleniyor ve iptal ediliyor ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Uyarı: Kurulumu bu aşamada iptal etmek paket sisteminin bozulmasına yol açabilir.</p><p>Kurulumu şimdi kesmek istediğinizden gerçekten emin misiniz ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Kurulumu root olarak çalıştıramazsınız !</p><p> Kurulum iptal ediliyor ...</p>"

