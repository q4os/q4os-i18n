msgid "< Back"
msgstr "< Retour"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Vérifications rapides du système</b><br>&nbsp;&nbsp;&nbsp;Le système vérifie l'environnement d'installation"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Obtenir les autorisations</b><br>&nbsp;&nbsp;&nbsp;Le système demande les autorisations d'installation"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Installation</b><br>&nbsp;&nbsp;&nbsp;Veuillez patienter pendant l'installation du logiciel"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Contrat de licence</b><br>&nbsp;&nbsp;&nbsp;Veuillez lire les termes de la licence avant l'installation"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Fin de l'assistant d'installation de _SUBST_SWNAME_</h2><br></p>\n<p>Le logiciel _SUBST_SWNAME_ a été installé sur votre ordinateur.<br></p>\n<p>Cliquez sur Terminer pour fermer l'assistant.<br><br><br><br><br></p>\n<p>Visitez le site web de _SUBST_SWNAME_ pour les dernières nouvelles, la FAQ et l'assistance</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr ""
"<p><h2>Bienvenue dans l'assistant d'installation de _SUBST_SWNAME_</h2></p>\n"
"<p>Cet assistant vous guidera dans l'installation de l'application _SUBST_SWNAME_.</p>\n"
"<p>Cliquez sur « Suivant » pour continuer.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Version du système d'exploitation détectée : Q4OS <b>%1</b>.</p><p>Cette installation de %2 nécessite au maximum Q4OS <b>%3</b>.</p><p> Annulation de l'installation ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Version du système d'exploitation détectée : Q4OS <b>%1</b>.</p><p>Cette installation de %2 nécessite au minimum Q4OS <b>%3</b>.</p><p> Annulation de l'installation ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Impossible de détecter la version du système Q4OS.</p><p>Annulation de l'installation ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Données initiales incomplètes !</p><p> Annulation de l'installation ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>La connexion Internet est désactivée ou très lente. L'installateur a besoin de télécharger les paquets de l'application à partir des sources internet de Q4OS. L'installation ne peut pas se poursuivre ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Pas de droits d'accès au système, vous n'êtes pas dans le groupe \"sudo\" !</p><p> Annulation de l'installation ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>Le système de paquets est occupé, il n'est pas possible de procéder à l'installation maintenant.</p><p>Le blocage est causé, très probablement, par l'installation de mises à jour en tâche de fond. Dans ce cas, vous devez patienter le temps que le système de paquets termine ces opérations. Merci de vérifier si vous n'êtes pas déjà en train de faire une installation et répétez l'opération dans quelques minutes.</p><p>Nettoyage et annulation en cours ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Le système de paquets est incohérent, il doit être récupéré manuellement. L'installation ne peut pas continuer maintenant.</p><p>Nettoyage et annulation ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Des paquets ne peuvent pas être téléchargés, merci de vérifier votre connexion internet. Désolé, je ne peux pas installer maintenant.</p><p>Nettoyage et annulation ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>La simulation n'a pas abouti, désolé, je ne peux pas installer maintenant.</p><p>Nettoyage et annulation ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Attention: l'annulation de l'installation à ce stade peut mettre le système de paquet en panne.</p><p>Etes vous vraiment sûr de vouloir interrompre le processus d'installation maintenant ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Vous ne pouvez pas lancer l'installation en tant que root !</p><p> Annulation de l'installation ...</p>"

