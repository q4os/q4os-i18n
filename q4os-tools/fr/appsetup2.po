msgstr "Annuler"

msgid "Canceling installation ..."
msgstr "Annulation de l'installation ..."

msgid "Cannot lock APT database, exiting ..."
msgstr "Impossible de verrouiller la base de données APT, fermeture ..."

msgid "Cannot lock Flatpak framework, exiting ..."
msgstr "Impossible de verrouiller Flatpak, fermeture ..."

