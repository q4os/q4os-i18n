msgstr "Het voorbereidingsscript vroeg om af te sluiten. Afsluitcode:"

msgid "Press Page Down to see the rest of agreement."
msgstr "Druk op Page Down om de rest van de overeenkomst te lezen."

msgid "Q4OS Install System v1.0"
msgstr "Q4OS-installatiesysteem v1.0"

msgid "Recovered ... OK"
