msgid "< Back"
msgstr "< Kembali"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Pemeriksaan cepat sistem</b><br>&nbsp;&nbsp;&nbsp;Sistem sedang memeriksa lingkungan pemasangan"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Mendapatkan izin</b><br>&nbsp;&nbsp;&nbsp;Sistem meminta izin pemasangan"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Memasang</b><br>&nbsp;&nbsp;&nbsp;Harap tunggu selagi perangkat lunak dipasang"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Perjanjian Lisensi</b><br>&nbsp;&nbsp;&nbsp;Harap baca ketentuan lisensi sebelum memasang"

msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Menyelesaikan wisaya pemasangan _SUBST_SWNAME_</h2><br></p>\n<p>Perangkat lunak _SUBST_SWNAME_ telah dipasang di komputer Anda.<br></p>\n<p>Klik Selesai untuk menutup wisaya.<br><br><br><br><br></p>\n<p>Kunjungi situs web _SUBST_SWNAME_ untuk berita terbaru, tanya jawab, dan dukungan</p>"

msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr "<p><h2>Selamat datang di wisaya pemasangan _SUBST_SWNAME_</h2></p>\n<p>Wisaya ini akan memandu Anda memasang aplikasi _SUBST_SWNAME_.</p>\n<p>Klik Lanjut untuk meneruskan.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Versi sistem operasi yang terdeteksi: Q4OS <b>%1</b>.</p><p>Pemasangan %2 ini memerlukan Q4OS paling tinggi <b>%3</b>.</p><p> Membatalkan pemasangan ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Versi sistem operasi yang terdeteksi: Q4OS <b>%1</b>.</p><p>Pemasangan %2 ini memerlukan Q4OS paling rendah <b>%3</b>.</p><p> Membatalkan pemasangan ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Gagal mendeteksi versi sistem Q4OS.</p><p>Membatalkan pemasangan ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Data awal tidak lengkap !</p><p> Membatalkan pemasangan ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>Koneksi Internet tidak aktif atau sangat lambat. Pemasang perlu mengunduh paket aplikasi dari sumber Internet Q4OS. Pemasangan tidak dapat dilanjutkan ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Tidak ada izin akses sistem, Anda bukan anggota grup \"sudo\" !</p><p> Membatalkan pemasangan ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>Sistem paket sedang sibuk, belum siap memasang sekarang. Pemasangan tidak dapat dilanjutkan.</p><p>Kunci ini kemungkinan besar disebabkan oleh pembaruan sistem yang berjalan di latar belakang. Jika demikian, Anda perlu menunggu sebentar sampai sistem paket menyelesaikan operasi tersebut. Pastikan Anda tidak sedang memasang aplikasi lain dan ulangi pemasangan beberapa menit lagi.</p><p>Membersihkan dan membatalkan ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Sistem paket dalam keadaan tidak konsisten dan harus dipulihkan secara manual. Pemasangan tidak dapat dilanjutkan sekarang.</p><p>Membersihkan dan membatalkan ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Paket tidak dapat diunduh, periksa koneksi Internet Anda. Maaf, pemasangan tidak dapat dilakukan sekarang.</p><p>Membersihkan dan membatalkan ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Simulasi tidak berhasil, maaf, pemasangan tidak dapat dilakukan sekarang.</p><p>Membersihkan dan membatalkan ...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Peringatan: Membatalkan pemasangan pada tahap ini dapat merusak sistem paket.</p><p>Apakah Anda benar-benar yakin ingin menghentikan proses pemasangan sekarang ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Anda tidak boleh menjalankan pemasangan sebagai root !</p><p> Membatalkan pemasangan ...</p>"

