msgstr "Brak repozytorium Flathub ... Anulowanie !"

msgid "No Flathub repository, exiting ..."
msgstr "Brak repozytorium Flathub, kończenie ..."

msgid "Not ready"
msgstr "Niegotowy"

msgid "Package"
msgstr "Pakiet"

