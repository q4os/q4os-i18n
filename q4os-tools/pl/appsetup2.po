msgstr "Instalowanie plików ... OK"

msgid "Installing package ..."
msgstr "Instalowanie pakietu ..."

msgid "Insufficient permissions, user isn't member of \"sudo\" group, exiting ..."
msgstr "Niewystarczające uprawnienia, użytkownik nie należy do grupy \"sudo\", kończenie ..."

msgid "License text ..."
msgstr "Umowa licencyjna ..."

msgid "Next >"
msgstr "Dalej >"

