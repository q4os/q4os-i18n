msgstr "Skrypt wstępny zażądał zakończenia. Kod wyjścia:"

# It would be good to add quotation or bold font for better button to click noticing.
msgid "Press Page Down to see the rest of agreement."
msgstr "Naciśnij przycisk 'Page Down' (PgDn) by zobaczyć resztę umowy."

msgid "Q4OS Install System v1.0"
msgstr "System instalacyjny Q4OS v1.0"

