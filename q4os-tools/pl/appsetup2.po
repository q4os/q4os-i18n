msgid "< Back"
msgstr "< Wstecz"

msgid "<b>Fast system checks</b><br>&nbsp;&nbsp;&nbsp;System is prechecking installation environment"
msgstr "<b>Szybkie sprawdzanie systemu</b><br>&nbsp;&nbsp;&nbsp;System sprawdza środowisko instalacji"

msgid "<b>Get permissions</b><br>&nbsp;&nbsp;&nbsp;System asks for installation permissions"
msgstr "<b>Uzyskiwanie uprawnień</b><br>&nbsp;&nbsp;&nbsp;System prosi o uprawnienia do instalacji"

msgid "<b>Installing</b><br>&nbsp;&nbsp;&nbsp;Please wait while software is being installed"
msgstr "<b>Instalowanie</b><br>&nbsp;&nbsp;&nbsp;Proszę czekać, trwa instalowanie oprogramowania"

msgid "<b>License Agreement</b><br>&nbsp;&nbsp;&nbsp;Please review the license terms before install"
msgstr "<b>Umowa licencyjna</b><br>&nbsp;&nbsp;&nbsp;Przed instalacją proszę zapoznać się z warunkami licencji"

# It would be good to add quotation or bold font for better button to click noticing.
msgid ""
"<p><h2>Completing _SUBST_SWNAME_ setup wizard</h2><br></p>\n"
"<p>Software _SUBST_SWNAME_ has been installed on your computer.<br></p>\n"
"<p>Click Finish to close the wizard.<br><br><br><br><br></p>\n"
"<p>Visit _SUBST_SWNAME_ website for the latest news, FAQs and support</p>"
msgstr "<p><h2>Kończenie pracy kreatora instalacji _SUBST_SWNAME_</h2><br></p>\n<p>Oprogramowanie _SUBST_SWNAME_ zostało zainstalowane na komputerze.<br></p>\n<p>Kliknij Zakończ, aby zamknąć kreatora.<br><br><br><br><br></p>\n<p>Odwiedź stronę _SUBST_SWNAME_, aby poznać nowości, odpowiedzi na częste pytania i uzyskać pomoc</p>"

# It would be good to add quotation or bold font for better button to click noticing.
msgid ""
"<p><h2>Welcome to the _SUBST_SWNAME_ setup wizard</h2></p>\n"
"<p>This wizard will guide you through the installation of the _SUBST_SWNAME_ application.</p>\n"
"<p>Click Next to continue.</p>\n"
msgstr ""
"<p><h2>Witaj w kreatorze instalacji _SUBST_SWNAME_</h2></p>\n"
"<p>Ten kreator przeprowadzi cię przez proces instalacji programu _SUBST_SWNAME_.</p>\n"
"<p>Naciśnij 'Dalej' by kontynuować.</p>\n"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as maximum.</p><p> Canceling installation ...</p>"
msgstr "<p>Wykryta wersja systemu operacyjnego: Q4OS <b>%1</b>.</p><p>Ta instalacja %2 wymaga Q4OS w wersji najwyżej <b>%3</b>.</p><p> Anulowanie instalacji ...</p>"

msgid "<p>Detected operating system version: Q4OS <b>%1</b>.</p><p>This %2 installation requires Q4OS <b>%3</b> as minimum.</p><p> Canceling installation ...</p>"
msgstr "<p>Wykryta wersja systemu operacyjnego: Q4OS <b>%1</b>.</p><p>Ta instalacja %2 wymaga Q4OS w wersji co najmniej <b>%3</b>.</p><p> Anulowanie instalacji ...</p>"

msgid "<p>Failed to detect Q4OS system version.</p><p>Canceling installation ...</p>"
msgstr "<p>Nie udało się wykryć wersji systemu Q4OS.</p><p>Anulowanie instalacji ...</p>"

msgid "<p>Initial data incomplete !</p><p> Canceling installation ...</p>"
msgstr "<p>Niekompletne dane początkowe !</p><p> Anulowanie instalacji ...</p>"

msgid "<p>Internet connection is inactive or very slow. Installer needs to download application packages from Q4OS Internet sources. Setup cannot continue ...</p>"
msgstr "<p>Połączenie internetowe jest nieaktywne lub bardzo powolne. Instalator musi pobrać pakiety aplikacji ze źródeł internetowych Q4OS. Instalator nie może kontynuować ...</p>"

msgid "<p>No system access permissions, you are not in \"sudo\" group !</p><p> Canceling installation ...</p>"
msgstr "<p>Brak uprawnień dostępu do systemu, nie należysz do grupy \"sudo\" !</p><p> Anulowanie instalacji ...</p>"

msgid "<p>Package system is busy, not ready to install now. Setup cannot continue.</p><p>The lock is caused, very probably, by ongoing background system updates. If this is the case, you have to wait a moment for package system to finish these operations. Please make sure you are not installing another application and repeat setup few minutes later.</p><p>Cleaning and canceling now ...</p>"
msgstr "<p>System pakietów jest zajęty, niegotowy do przeprowadzenia instalacji. Instalator nie może kontynuować.</p><p>Blokada jest spowodowana najprawdopodobniej przez aktualizacje systemu działające w tle. Jeśli tak jest, musisz chwilę poczekać aby system skończył obecne działania. Proszę upewnij się, że nie instalujesz w tle innej aplikacji i spróbuj ponownie za parę minut.</p><p>Czyszczenie i anulowanie ...</p>"

msgid "<p>Package system is in non consistent state, it has to be recovered manually. Installation cannot continue now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>System pakietów spójny, spójność musi być przywrócona manualnie. Instalacja nie może obecnie kontynuować.</p><p>Czyszczenie i anulowanie ...</p>"

msgid "<p>Packages couldn't be downloaded, please check your Internet connection. Sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Pakiety nie mogą być obecnie pobrane, sprawdź połączenie internetowe. Przepraszamy, nie można obecnie zainstalować.</p><p>Czyszczenie i anulowanie ...</p>"

msgid "<p>Simulation not successful, sorry, I cannot install now.</p><p>Cleaning and canceling ...</p>"
msgstr "<p>Symulacja nie powiodła się, przepraszamy, nie można obecnie zainstalować.</p><p>Czyszczenie i anulowanie...</p>"

msgid "<p>Warning: Canceling installation during this phase could result in package system failure.</p><p>Are you really sure, you want to interrupt the install process now ?</p>"
msgstr "<p>Ostrzeżenie: Anulowanie instalacji w tym stanie może doprowadzić do uszkodzenia systemu.</p><p>Jesteś pewien, że chcesz przerwać proces instalacji ?</p>"

msgid "<p>You may not run setup under root !</p><p> Canceling installation ...</p>"
msgstr "<p>Instalatora nie można uruchamiać jako root !</p><p> Anulowanie instalacji ...</p>"

msgid "Adding security keys ..."
msgstr "Dodawanie kluczy bezpieczeństwa ..."

msgid "Adding security keys ... OK"
msgstr "Dodawanie kluczy bezpieczeństwa ... OK"

msgid "Autofix not needed ... OK"
msgstr "Autonaprawa nie jest konieczna ... OK"

msgid "Bad password !"
msgstr "Błędne hasło !"

msgid "Busy !"
msgstr "Zajęty !"

msgid "CPU architecture doesn't match, exiting"
msgstr "Architektura procesora nie pasuje, kończenie"

msgid "Calculating progress ..."
msgstr "Obliczanie postępu ..."

msgid "Cancel"
msgstr "Anuluj"

msgid "Canceling installation ..."
msgstr "Anulowanie instalacji ..."

msgid "Cannot lock APT database, exiting ..."
msgstr "Nie można zablokować bazy danych APT, kończenie ..."

msgid "Cannot lock Flatpak framework, exiting ..."
msgstr "Nie można zablokować Flatpak, kończenie ..."

msgid "Checking architecture"
msgstr "Sprawdzanie architektury"

msgid "Checking current user"
msgstr "Sprawdzanie bieżącego użytkownika"

msgid "Checking distro"
msgstr "Sprawdzanie dystrybucji"

msgid "Checking environment"
msgstr "Sprawdzanie środowiska"

msgid "Checking for %1 software"
msgstr "Sprawdzanie oprogramowania %1"

msgid "Checking installation ..."
msgstr "Sprawdzanie instalacji ..."

msgid "Checking installation ... Error !"
msgstr "Sprawdzanie instalacji ... Błąd !"

msgid "Checking installation ... OK"
msgstr "Sprawdzanie instalacji ... OK"

msgid "Checking package system"
msgstr "Sprawdzanie systemu pakietów"

msgid "Checking package system ..."
msgstr "Sprawdzanie systemu pakietów ..."

msgid "Checking setup archive integrity"
msgstr "Sprawdzanie integralności archiwum instalacyjnego"

msgid "Checking user rights"
msgstr "Sprawdzanie uprawnień użytkownika"

msgid "Cleaning and canceling now ..."
msgstr "Czyszczenie i anulowanie ..."

msgid "Configuring Apt ..."
msgstr "Konfigurowanie Apt ..."

msgid "Configuring Apt ... Done"
msgstr "Konfigurowanie Apt ... Gotowe"

msgid "Copying system packages ..."
msgstr "Kopiowanie pakietów systemowych ..."

msgid "Copying system packages ... Done"
msgstr "Kopiowanie pakietów systemowych ... Gotowe"

msgid "Could not initialize, incorrect data header !"
msgstr "Nie można zainicjować, nieprawidłowy nagłówek danych !"

msgid "Could not initialize, incorrect data header."
msgstr "Nie można zainicjować, nieprawidłowy nagłówek danych."

msgid "Could not run Q4OS low-level apt utilities ! It is a serious problem, breaking the installation ..."
msgstr "Nie można uruchomić niskopoziomowych narzędzi apt systemu Q4OS ! To poważny problem, instalacja zostaje przerwana ..."

msgid "Detecting operating system version"
msgstr "Wykrywanie wersji systemu operacyjnego"

msgid "Determining Flatpak configuration ... "
msgstr "Określanie konfiguracji Flatpak ... "

msgid "Distro"
msgstr "Dystrybucja"

msgid "Do you really want to cancel pending operation ?"
msgstr "Czy na pewno chcesz anulować oczekującą operację?"

msgid "Done"
msgstr "Gotowe"

msgid "Downloading packages ..."
msgstr "Pobieranie pakietów ..."

msgid "Downloading packages ... Done"
msgstr "Pobieranie pakietów ... Gotowe"

msgid "Enter your password to continue:"
msgstr "Podaj swoje hasło by kontynuować:"

msgid "Extracting archive ..."
msgstr "Wypakowywanie ..."

msgid "Extracting archive ... Done"
msgstr "Wypakowywanie ... Gotowe"

msgid "Failed"
msgstr "Niepowodzenie"

msgid "Failed !"
msgstr "Niepowodzenie !"

msgid "Failed. Configuration file doesn't exist."
msgstr "Niepowodzenie. Plik konfiguracyjny nie istnieje."

msgid "Failed. Input file doesn't exist."
msgstr "Niepowodzenie. Plik wejściowy nie istnieje."

msgid "Finish >"
msgstr "Zakończ >"

msgid "Finishing installation ..."
msgstr "Kończenie instalacji ..."

msgid "Flatpak framework is busy, another application is being installed just now."
msgstr "Flatpak jest zajęty, właśnie instalowana jest inna aplikacja."

msgid "Flatpak is installed, but the Flathub repository isn't included. Please add Flathub repository first. Canceling installation ..."
msgstr "Flatpak jest zainstalowany, ale brakuje repozytorium Flathub. Najpierw dodaj repozytorium Flathub. Anulowanie instalacji ..."

msgid "Flatpak is not installed, so cancelling installation. Please install flatpak package first ..."
msgstr "Flatpak nie jest zainstalowany, instalacja zostaje anulowana. Najpierw zainstaluj pakiet flatpak ..."

msgid "Flatpak isn't installed ... Cancel !"
msgstr "Flatpak nie jest zainstalowany ... Anulowanie !"

msgid "Flatpak isn't installed, exiting ..."
msgstr "Flatpak nie jest zainstalowany, kończenie ..."

msgid "I Agree"
msgstr "Zgadzam się"

# It would be good to add quotation or bold font for better button to click noticing.
msgid "If you accept the terms of the agreement, click I Agree to continue. You must accept the agreement to install _SUBST_SWNAME_ software."
msgstr "Jeżeli akceptujesz postanowienia licencyjne, naciśnij 'Zgadzam się' by kontynuować. Musisz zaakceptować umowę aby zainstalować program _SUBST_SWNAME_."

msgid "Install >"
msgstr "Instaluj >"

msgid "Installation failed !"
msgstr "Instalacja nie powiodła się !"

msgid "Installation not successful."
msgstr "Instalacja nie powiodła się."

msgid "Installation successfully completed :-)"
msgstr "Instalacja powiodła się :-)"

